{
  // Private Admin dashboard + operator MCP, sharing the same permanent D1/R2
  // as the public Worker. NO customer checkout routes are bundled here.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "__ADMIN_NAME__",
  "main": "./src/admin-worker.ts",
  "compatibility_date": "2026-07-20",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // These routes begin unrouted and will need owner-only Cloudflare Access
  // protection before attaching an Admin hostname. Admin MCP is operator-only.
  "vars": {
    "STORE_NAME": "Purkins",
    "TIME_ZONE": "Africa/Lusaka",
    "PRELAUNCH_NOINDEX": "true",
    "PURKINS_MCP_WRITES_ENABLED": "false"
  },
  "ratelimits": [
    { "name": "AUTH_RATE_LIMITER", "namespace_id": "10001", "simple": { "limit": 10, "period": 60 } },
    { "name": "CHECKOUT_RATE_LIMITER", "namespace_id": "10002", "simple": { "limit": 20, "period": 60 } },
    { "name": "SEARCH_RATE_LIMITER", "namespace_id": "10003", "simple": { "limit": 60, "period": 60 } }
  ],
  "unsafe": {
    "bindings": [
      { "name": "MCP_RATE_LIMITER", "type": "ratelimit", "namespace_id": "2001",
        "simple": { "limit": 30, "period": 60 } }
    ]
  },
  // Temporary compatibility with existing working MCP implementation. Once
  // stateless createMcpHandler replaces McpAgent, remove this Durable Object.
  "durable_objects": {
    "bindings": [{ "name": "STORE_MCP", "class_name": "StoreMcp" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["StoreMcp"] }],
  "d1_databases": [
    { "binding": "DB", "database_name": "__DB_NAME__", "database_id": "__DB_ID__",
      "migrations_dir": "migrations" }
  ],
  "r2_buckets": [
    { "binding": "BUCKET", "bucket_name": "__BUCKET__" },
    { "binding": "FILES", "bucket_name": "__FILES_BUCKET__" }
  ]
}
