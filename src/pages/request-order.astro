---
export const prerender = false;
import { env } from 'cloudflare:workers';
import Layout from '../layouts/Layout.astro';
import { getConfig, formatPrice } from '../config';
import { readCart, resolveCart, clearCart } from '../features/cart/cart';
import { parseOrderRequestForm, validateRequestCart, REQUEST_FULFILLMENT_OPTIONS, REQUEST_PAYMENT_OPTIONS } from '../features/purkins/orderRequests';
import { createOrderRequest } from '../features/purkins/orderRequestDb';
import { catalogPath } from '../features/settings/home';

Astro.response.headers.set('cache-control', 'private, no-store');
Astro.response.headers.set('referrer-policy', 'no-referrer');
const cart = readCart(Astro.cookies);
const { lines, subtotalCents } = await resolveCart(env.DB, cart);
const cartError = Object.keys(cart).length !== lines.length
  ? 'Some items in your cart are no longer available. Review your cart before requesting.'
  : validateRequestCart(lines, subtotalCents);
let error: string | null = null;
if (Astro.request.method === 'POST') {
  const origin = Astro.request.headers.get('origin');
  const fetchSite = Astro.request.headers.get('sec-fetch-site');
  if ((origin && origin !== Astro.url.origin) ||
      (fetchSite && !['same-origin','none'].includes(fetchSite))) {
    return new Response('Invalid request origin.', { status: 403 });
  }
  if (cartError) {
    error = cartError;
  } else {
    const form = await Astro.request.formData();
    const parsed = parseOrderRequestForm(form);
    if (!parsed.ok) {
      error = parsed.error;
    } else {
      try {
        const result = await createOrderRequest(env.DB, parsed.fields, lines, subtotalCents);
        if (result.ok) {
          clearCart(Astro.cookies);
          return Astro.redirect('/request-order/thanks?ref=' + encodeURIComponent(result.publicId), 303);
        }
        error = result.error;
      } catch (err) {
        console.error(JSON.stringify({
          event: 'purkins_customer_order_request_failed',
          message: err instanceof Error ? err.message : String(err),
        }));
        error = 'We could not save your request. No payment was taken. Please try again or contact Purkins.';
      }
    }
  }
}
const requestId = crypto.randomUUID();
const currency = getConfig().currency;
const shopHref = catalogPath(Astro.locals.settings?.homePage);
---
<Layout title="Request your Purkins order" description="Order baby and mum essentials and arrange payment on delivery or after confirmation.">
  <div class="mx-auto max-w-3xl py-8">
    <a href="/cart" class="text-sm text-muted hover:text-brand">&larr; Back to cart</a>
    <h1 class="mt-5 font-serif text-3xl tracking-tight">Request your order</h1>
    <p class="mt-2 text-sm text-muted">
      Choose how you would like to pay. We will contact you to confirm availability,
      the delivery or pickup arrangement, and the final total before completing your order.
      <strong>No payment is taken by this form.</strong>
    </p>
    {error && <p role="alert" class="mt-5 rounded-md border border-red-300 bg-red-50 p-4 text-sm text-red-900">{error}</p>}
    {cartError ? (
      <div class="mt-6 rounded-md border border-line p-5">
        <p>{cartError}</p>
        <a href={shopHref} class="mt-3 inline-block text-brand underline">Continue shopping</a>
      </div>
    ) : (
      <>
        <section class="mt-7 rounded-lg border border-line bg-surface p-5">
          <h2 class="font-semibold">Your items</h2>
          <ul class="mt-3 divide-y divide-line">
            {lines.map(line => (
              <li class="flex items-start justify-between gap-4 py-3 text-sm">
                <span>{line.product.name}{line.variant ? ' — ' + line.variant.label : ''}
                  {line.extras.length ? ' + ' + line.extras.map(e => e.label).join(', ') : ''}
                  <span class="text-muted"> × {line.qty}</span>
                </span>
                <span class="shrink-0 tabular-nums">{formatPrice(line.lineTotalCents, currency)}</span>
              </li>
            ))}
          </ul>
          <div class="mt-3 flex items-center justify-between border-t border-line pt-3 font-semibold">
            <span>Product subtotal</span><span>{formatPrice(subtotalCents,currency)}</span>
          </div>
          <p class="mt-2 text-xs text-muted">
            Delivery charges, if applicable, are NOT included. We'll agree on any
            delivery fee and the final amount before accepting the order.
          </p>
        </section>
        <form method="POST" class="mt-7 space-y-5 rounded-lg border border-line p-5">
          <input type="hidden" name="request_id" value={requestId} />
          <div class="hidden" aria-hidden="true">
            <label>Leave this field blank <input name="website" tabindex="-1" autocomplete="off" /></label>
          </div>
          <div class="grid gap-4 sm:grid-cols-2">
            <label class="block text-sm font-medium">Your name *
              <input type="text" name="customer_name" required minlength="2" maxlength="100"
                autocomplete="name" class="mt-1 w-full rounded-md border border-line bg-surface px-3 py-2" />
            </label>
            <label class="block text-sm font-medium">Phone / WhatsApp number *
              <input type="tel" name="phone" required autocomplete="tel" maxlength="24"
                placeholder="097… or +260…" class="mt-1 w-full rounded-md border border-line bg-surface px-3 py-2" />
            </label>
          </div>
          <label class="block text-sm font-medium">Email (optional)
            <input type="email" name="email" autocomplete="email" maxlength="200"
              class="mt-1 w-full rounded-md border border-line bg-surface px-3 py-2" />
          </label>
          <label class="block text-sm font-medium">How would you like to pay? *
            <select name="payment_preference" required class="mt-1 w-full rounded-md border border-line bg-surface px-3 py-2">
              {Object.entries(REQUEST_PAYMENT_OPTIONS).map(([value,label]) => (
                <option value={value}>{label}</option>
              ))}
            </select>
          </label>
          <p class="text-xs text-muted">
            Pay on delivery is subject to confirmation of your area and order.
            If you prefer mobile money or bank transfer, we'll provide payment instructions
            after confirming the order. Please don't send money yet.
          </p>
          <label class="block text-sm font-medium">Delivery or pickup? *
            <select name="fulfillment_preference" required class="mt-1 w-full rounded-md border border-line bg-surface px-3 py-2">
              {Object.entries(REQUEST_FULFILLMENT_OPTIONS).map(([value,label]) => (
                <option value={value}>{label}</option>
              ))}
            </select>
          </label>
          <label class="block text-sm font-medium">Area / neighbourhood (required for delivery)
            <input name="area" maxlength="120" autocomplete="address-level2"
              placeholder="e.g. Chilenje, Lusaka"
              class="mt-1 w-full rounded-md border border-line bg-surface px-3 py-2" />
          </label>
          <label class="block text-sm font-medium">Delivery directions (optional)
            <textarea name="address_notes" maxlength="500" rows="2"
              class="mt-1 w-full rounded-md border border-line bg-surface px-3 py-2"></textarea>
          </label>
          <label class="block text-sm font-medium">Any questions or instructions? (optional)
            <textarea name="customer_note" maxlength="500" rows="2"
              class="mt-1 w-full rounded-md border border-line bg-surface px-3 py-2"></textarea>
          </label>
          <label class="flex items-start gap-3 text-sm">
            <input type="checkbox" name="acknowledge" value="yes" required class="mt-1" />
            <span>I agree to be contacted about this request. I understand my order is not confirmed,
              no payment has been made, and availability and delivery charges must be confirmed by Purkins.</span>
          </label>
          <button type="submit"
            class="w-full rounded-md bg-brand px-5 py-3 text-sm font-semibold text-on-brand hover:bg-brand-hover">
            Submit order request
          </button>
        </form>
      </>
    )}
  </div>
</Layout>
