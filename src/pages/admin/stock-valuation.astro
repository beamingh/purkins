---
import { env } from 'cloudflare:workers';
import AdminLayout from '../../layouts/AdminLayout.astro';
import { formatPrice } from '../../config';
import { getStockValuation } from '../../features/purkins/stockValuation';

const value=await getStockValuation(env.DB);
const money=(cents:number|null)=>
  cents==null?'Not yet calculable':formatPrice(cents,'zmw');
const percent=(covered:number,total:number)=>
  total>0?Math.round(100*covered/total):100;
const pricedPct=percent(value.pricedUnits,value.totalUnits);
const costPct=percent(value.costedUnits,value.totalUnits);
const canCalculateProfit=value.completePotentialGrossProfitCents!==null;
---
<AdminLayout title="Inventory valuation" active="products">
  <header class="mb-6">
    <a href="/admin/products" class="text-xs text-brand underline">&larr; Products</a>
    <h1 class="mt-3 font-serif text-3xl">Stock value and potential gross revenue</h1>
    <p class="mt-2 max-w-3xl text-sm text-gray-600">
      Values reflect <strong>currently recorded, unsold inventory only</strong>,
      including unpublished drafts. They exclude stock you have not yet entered,
      future replenishment, courier charges and money already earned from sales.
      Selling everything at the listed prices is a scenario, not a forecast.
    </p>
  </header>

  <section aria-label="Inventory valuation overview" class="mb-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    <div class="rounded-lg border border-gray-200 bg-white p-4">
      <p class="text-xs uppercase tracking-wide text-gray-500">Recorded stock</p>
      <p class="mt-2 text-3xl font-semibold tabular-nums">{value.totalUnits}</p>
      <p class="mt-1 text-xs text-gray-500">{value.productCount} products · {value.lineCount} stock/size lines</p>
    </div>
    <div class="rounded-lg border border-gray-200 bg-white p-4">
      <p class="text-xs uppercase tracking-wide text-gray-500">Known priced stock — retail value</p>
      <p class="mt-2 text-3xl font-semibold tabular-nums">{money(value.pricedValueCents)}</p>
      <p class="mt-1 text-xs text-gray-500">Only {value.pricedUnits} of {value.totalUnits} units have selling prices</p>
    </div>
    <div class="rounded-lg border border-gray-200 bg-white p-4">
      <p class="text-xs uppercase tracking-wide text-gray-500">Known landed stock cost</p>
      <p class="mt-2 text-3xl font-semibold tabular-nums">{money(value.knownCostValueCents)}</p>
      <p class="mt-1 text-xs text-gray-500">Only {value.costedUnits} of {value.totalUnits} units have convertible purchase costs</p>
    </div>
    <div class="rounded-lg border border-gray-200 bg-white p-4">
      <p class="text-xs uppercase tracking-wide text-gray-500">Potential gross profit — complete inventory</p>
      <p class="mt-2 text-2xl font-semibold tabular-nums">{money(value.completePotentialGrossProfitCents)}</p>
      <p class="mt-1 text-xs text-gray-500">
        {canCalculateProfit
          ? 'Selling prices less recorded landed unit costs'
          : 'Requires both selling price and landed cost for every remaining unit'}
      </p>
    </div>
  </section>

  <section class="mb-6 grid gap-4 md:grid-cols-2">
    <div class="rounded-lg border border-gray-200 bg-white p-5">
      <h2 class="font-semibold">Potential revenue if all recorded stock sells</h2>
      <p class="mt-3 text-2xl font-semibold tabular-nums">{money(value.completePotentialRevenueCents)}</p>
      <p class="mt-2 text-sm text-gray-600">
        The known priced portion is {money(value.pricedValueCents)}.
        {value.unpricedUnits} remaining units lack a retail price, so the full total
        would be misleading until they are priced.
      </p>
    </div>
    <div class="rounded-lg border border-gray-200 bg-white p-5">
      <h2 class="font-semibold">Total inventory acquisition / landed cost</h2>
      <p class="mt-3 text-2xl font-semibold tabular-nums">{money(value.completeInventoryCostCents)}</p>
      <p class="mt-2 text-sm text-gray-600">
        The cost-known portion is {money(value.knownCostValueCents)}.
        {value.missingCostUnits} units have missing purchase costs or an unentered
        ZAR-to-ZMW conversion. Original retailer price tags are <strong>not</strong>
        acquisition costs.
      </p>
    </div>
  </section>

  <section class="mb-6 rounded-lg border border-gray-200 bg-white p-5">
    <h2 class="font-semibold">Data completeness</h2>
    <div class="mt-4 space-y-4">
      <div>
        <div class="mb-1 flex justify-between text-sm"><span>Retail price coverage</span><span class="tabular-nums">{value.pricedUnits}/{value.totalUnits} units ({pricedPct}%)</span></div>
        <div class="h-3 overflow-hidden rounded-full bg-gray-100"><div class="h-full bg-brand" style={{width:pricedPct+'%'}}></div></div>
      </div>
      <div>
        <div class="mb-1 flex justify-between text-sm"><span>Purchase cost coverage</span><span class="tabular-nums">{value.costedUnits}/{value.totalUnits} units ({costPct}%)</span></div>
        <div class="h-3 overflow-hidden rounded-full bg-gray-100"><div class="h-full bg-brand" style={{width:costPct+'%'}}></div></div>
      </div>
    </div>
    {value.currencyExceptions>0&&<p class="mt-3 text-sm text-red-700">{value.currencyExceptions} non-ZMW stock lines need currency review before interpreting the totals.</p>}
    {value.negativeStockLines>0&&<p class="mt-3 text-sm text-red-700">{value.negativeStockLines} lines have negative stock balances that must be reconciled.</p>}
    {value.matchedUnits>0&&<p class="mt-3 text-sm text-gray-600">
      For the {value.matchedUnits} units with both cost and selling prices, comparable
      potential gross profit is <strong>{money(value.comparableGrossProfitCents)}</strong>.
      This subtotal must not be presented as profit on all inventory.
    </p>}
  </section>

  <section class="rounded-lg border border-gray-200 bg-white">
    <div class="flex flex-wrap items-center justify-between gap-3 p-5">
      <div>
        <h2 class="font-semibold">Inventory lines and missing values</h2>
        <p class="mt-1 text-xs text-gray-600">Unpriced or uncosted items appear first. Every variant is counted once, never together with its parent.</p>
      </div>
      <a href="/admin/products" class="text-sm font-semibold text-brand underline">Edit product pricing</a>
    </div>
    <div class="overflow-x-auto">
      <table class="w-full min-w-[780px] text-left text-sm">
        <thead class="bg-gray-50 text-gray-600">
          <tr>
            <th class="px-4 py-3">Product / size</th>
            <th class="px-4 py-3 text-right">Units</th>
            <th class="px-4 py-3 text-right">Unit selling price</th>
            <th class="px-4 py-3 text-right">Landed cost per unit</th>
            <th class="px-4 py-3 text-right">Potential sales</th>
            <th class="px-4 py-3">Status</th>
          </tr>
        </thead>
        <tbody>
          {value.lines.map(line=>(
            <tr class="border-t border-gray-100">
              <td class="px-4 py-3">
                {line.product_public_id?(
                  <a class="font-medium text-brand underline" href={'/admin/products/'+line.product_public_id+'/edit'}>{line.name}</a>
                ):(<strong>{line.name}</strong>)}
                {line.variant_label&&<p class="text-xs text-gray-500">{line.variant_label}</p>}
              </td>
              <td class="px-4 py-3 text-right tabular-nums">{line.units}</td>
              <td class="px-4 py-3 text-right tabular-nums">{line.price_cents>0?money(line.price_cents):'Missing'}</td>
              <td class="px-4 py-3 text-right tabular-nums">{line.landed_unit_cost_cents!==null?money(line.landed_unit_cost_cents):'Missing'}</td>
              <td class="px-4 py-3 text-right tabular-nums">{line.price_cents>0?money(line.units*line.price_cents):'Unpriced'}</td>
              <td class="px-4 py-3 text-xs">
                <span class={line.published?'text-green-700':'text-gray-600'}>{line.published?'Published':'Draft'}</span>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
      {value.lines.length===0&&<p class="p-5 text-sm text-gray-600">No remaining stock has been entered.</p>}
    </div>
    {value.detailTruncated&&<p class="border-t border-amber-200 bg-amber-50 p-4 text-sm text-amber-900">
      Showing only the first 150 non-empty stock lines, prioritizing missing values.
      Financial totals above are computed across <strong>all</strong> recorded stock.
    </p>}
  </section>

  <p class="mt-5 text-xs text-gray-500">
    Gross profit here means potential sales less landed inventory cost only.
    It is before platform charges, refunds, marketing, other operating expenses and taxes.
    It is not realized revenue, net profit or a guaranteed sales forecast.
  </p>
</AdminLayout>
