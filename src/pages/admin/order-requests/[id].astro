---
import { env } from 'cloudflare:workers';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { formatPrice, formatDate, getConfig } from '../../../config';
import { getOrderRequest, listRequestLines } from '../../../features/purkins/orderRequestDb';
import {
  REQUEST_FULFILLMENT_OPTIONS, REQUEST_PAYMENT_OPTIONS, REQUEST_STATUSES,
} from '../../../features/purkins/orderRequests';

const request = await getOrderRequest(env.DB, Astro.params.id ?? '');
if (!request) return new Response('Order request not found.', { status: 404 });
const lines = await listRequestLines(env.DB,request.id);
const timeZone = Astro.locals.settings?.timeZone ?? getConfig().timeZone;
const error = Astro.url.searchParams.get('error');
const saved = Astro.url.searchParams.get('saved') === '1';
---
<AdminLayout title="Customer order request" active="orders">
  <a href="/admin/order-requests" class="text-xs text-gray-500 hover:text-brand">&larr; All order requests</a>
  <h1 class="mt-2 text-2xl font-bold">Request {request.public_id}</h1>
  <p class="mt-1 text-sm text-gray-500">{formatDate(request.created_at,undefined,timeZone)} · {REQUEST_STATUSES[request.status]}</p>
  <p class="mt-4 rounded-md border border-amber-300 bg-amber-50 p-4 text-sm text-amber-900">
    <strong>Unpaid and unconfirmed.</strong> No inventory has been reserved or deducted.
    Confirm availability, any delivery fees and the payment arrangement before promising fulfillment.
    Never mark a customer as paid based solely on a screenshot.
  </p>
  {error && <p role="alert" class="mt-3 rounded-md border border-red-200 bg-red-50 p-3 text-sm text-red-800">{error}</p>}
  {saved && <p role="status" class="mt-3 rounded-md border border-green-200 bg-green-50 p-3 text-sm text-green-800">Request updated.</p>}
  <div class="mt-6 grid gap-6 lg:grid-cols-2">
    <section class="rounded-lg border border-gray-200 bg-white p-5">
      <h2 class="text-lg font-semibold">Contact and arrangement</h2>
      <dl class="mt-4 space-y-3 text-sm">
        <div><dt class="text-gray-500">Name</dt><dd>{request.buyer_name}</dd></div>
        <div><dt class="text-gray-500">Phone</dt><dd><a href={'tel:' + request.phone} class="text-brand underline">{request.phone}</a></dd></div>
        {request.email && <div><dt class="text-gray-500">Email</dt><dd>{request.email}</dd></div>}
        <div><dt class="text-gray-500">Payment preference</dt><dd>{REQUEST_PAYMENT_OPTIONS[request.payment_preference]}</dd></div>
        <div><dt class="text-gray-500">Fulfillment preference</dt><dd>{REQUEST_FULFILLMENT_OPTIONS[request.fulfillment_preference]}</dd></div>
        {request.area && <div><dt class="text-gray-500">Area</dt><dd>{request.area}</dd></div>}
        {request.address_notes && <div><dt class="text-gray-500">Delivery directions</dt><dd class="whitespace-pre-wrap">{request.address_notes}</dd></div>}
        {request.customer_note && <div><dt class="text-gray-500">Customer message</dt><dd class="whitespace-pre-wrap">{request.customer_note}</dd></div>}
      </dl>
    </section>
    <section class="rounded-lg border border-gray-200 bg-white p-5">
      <h2 class="text-lg font-semibold">Requested items</h2>
      <ul class="mt-3 divide-y divide-gray-100 text-sm">
        {lines.map(line => (
          <li class="flex justify-between gap-4 py-3">
            <span>{line.product_name} × {line.quantity}</span>
            <span class="tabular-nums">{formatPrice(line.unit_price_cents * line.quantity,request.currency)}</span>
          </li>
        ))}
      </ul>
      <p class="mt-3 border-t border-gray-200 pt-3 font-semibold">
        Product subtotal: {formatPrice(request.subtotal_cents,request.currency)}
      </p>
      <p class="mt-2 text-xs text-gray-500">Final total is subject to confirmed delivery fees. No funds recorded.</p>
    </section>
  </div>
  <section class="mt-6 rounded-lg border border-gray-200 bg-white p-5">
    <h2 class="text-lg font-semibold">Follow-up status</h2>
    <form method="POST" action={'/api/admin/order-requests/' + request.public_id} class="mt-4 space-y-4">
      <input type="hidden" name="expected_status" value={request.status} />
      <label class="block text-sm">Update status
        <select name="status" class="mt-1 block w-full max-w-xs rounded-md border border-gray-300 px-3 py-2" disabled={request.status === 'cancelled'}>
          <option value="contacted">Customer contacted</option>
          <option value="awaiting_payment">Awaiting payment or delivery/handover</option>
          <option value="cancelled">Cancelled / unavailable</option>
        </select>
      </label>
      <label class="block text-sm">Internal note (not visible to the customer)
        <textarea name="operator_note" maxlength="1000" rows="3"
          class="mt-1 block w-full rounded-md border border-gray-300 px-3 py-2"
        >{request.operator_note ?? ''}</textarea>
      </label>
      <button type="submit" disabled={request.status === 'cancelled'}
        class="rounded-md bg-brand px-5 py-2 font-semibold text-white disabled:opacity-50">
        Save follow-up
      </button>
    </form>
  </section>
  <section class="mt-6 rounded-lg border border-gray-200 p-5">
    <h2 class="text-lg font-semibold">When payment is actually received</h2>
    <p class="mt-2 text-sm text-gray-600">
      Verify funds in the receiving account or collect cash, then record a paid
      sale using the existing manual-sale screen. This request remains separate until
      an audited conversion workflow is implemented. Do not record a paid sale in advance.
    </p>
    <a href="/admin/orders/new" class="mt-3 inline-block text-brand underline">Record a verified paid manual sale</a>
  </section>
</AdminLayout>
