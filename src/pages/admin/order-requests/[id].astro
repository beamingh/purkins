---
import { env } from 'cloudflare:workers';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { formatPrice, formatDate, getConfig } from '../../../config';
import { getOrderRequest, listRequestLines } from '../../../features/purkins/orderRequestDb';
import { getOfflineQuote, listOfflineQuoteEvents } from '../../../features/purkins/offlineQuoteDb';
import { getOfflineStockHold } from '../../../features/purkins/offlineStockHoldDb';
import {
  REQUEST_FULFILLMENT_OPTIONS, REQUEST_PAYMENT_OPTIONS, REQUEST_STATUSES,
} from '../../../features/purkins/orderRequests';

const request = await getOrderRequest(env.DB, Astro.params.id ?? '');
if (!request) return new Response('Order request not found.', { status: 404 });
const lines = await listRequestLines(env.DB,request.id);
const quote = await getOfflineQuote(env.DB,request.id);
const allocation = await getOfflineStockHold(env.DB,request.id);
const isHeld = allocation?.status === 'held';
const holdSaved = Astro.url.searchParams.get('hold_saved') === '1';
const holdReleased = Astro.url.searchParams.get('hold_released') === '1';
const quoteHistory = quote ? await listOfflineQuoteEvents(env.DB,request.id) : [];
const quoteSaved = Astro.url.searchParams.get('quote_saved') === '1';
const timeZone = Astro.locals.settings?.timeZone ?? getConfig().timeZone;
const error = Astro.url.searchParams.get('error');
const saved = Astro.url.searchParams.get('saved') === '1';
---
<AdminLayout title="Customer order request" active="orders">
  <a href="/admin/order-requests" class="text-xs text-gray-500 hover:text-brand">&larr; All order requests</a>
  <h1 class="mt-2 text-2xl font-bold">Request {request.public_id}</h1>
  <p class="mt-1 text-sm text-gray-500">{formatDate(request.created_at,undefined,timeZone)} · {REQUEST_STATUSES[request.status]}</p>
  <p class="mt-4 rounded-md border border-amber-300 bg-amber-50 p-4 text-sm text-amber-900">
    <strong>Unpaid customer request.</strong>
    {isHeld
      ? ' Stock is currently allocated for this customer, but payment has NOT been received or verified.'
      : ' No inventory is currently allocated to this request.'}
    Confirm the final delivery arrangement and payment directly with the customer.
    Never mark an order paid solely from a screenshot.
  </p>
  {error && <p role="alert" class="mt-3 rounded-md border border-red-200 bg-red-50 p-3 text-sm text-red-800">{error}</p>}
  {saved && <p role="status" class="mt-3 rounded-md border border-green-200 bg-green-50 p-3 text-sm text-green-800">Request updated.</p>}
  <div class="mt-6 grid gap-6 lg:grid-cols-2">
    <section class="rounded-lg border border-gray-200 bg-white p-5">
      <h2 class="text-lg font-semibold">Contact and arrangement</h2>
      <dl class="mt-4 space-y-3 text-sm">
        <div><dt class="text-gray-500">Name</dt><dd>{request.buyer_name}</dd></div>
        <div><dt class="text-gray-500">Phone</dt><dd><a href={'tel:' + request.phone} class="text-brand underline">{request.phone}</a></dd></div>
        {request.email && <div><dt class="text-gray-500">Email</dt><dd>{request.email}</dd></div>}
        <div><dt class="text-gray-500">Payment preference</dt><dd>{REQUEST_PAYMENT_OPTIONS[request.payment_preference]}</dd></div>
        <div><dt class="text-gray-500">Fulfillment preference</dt><dd>{REQUEST_FULFILLMENT_OPTIONS[request.fulfillment_preference]}</dd></div>
        {request.area && <div><dt class="text-gray-500">Area</dt><dd>{request.area}</dd></div>}
        {request.address_notes && <div><dt class="text-gray-500">Delivery directions</dt><dd class="whitespace-pre-wrap">{request.address_notes}</dd></div>}
        {request.customer_note && <div><dt class="text-gray-500">Customer message</dt><dd class="whitespace-pre-wrap">{request.customer_note}</dd></div>}
      </dl>
    </section>
    <section class="rounded-lg border border-gray-200 bg-white p-5">
      <h2 class="text-lg font-semibold">Requested items</h2>
      <ul class="mt-3 divide-y divide-gray-100 text-sm">
        {lines.map(line => (
          <li class="flex justify-between gap-4 py-3">
            <span>{line.product_name} × {line.quantity}</span>
            <span class="tabular-nums">{formatPrice(line.unit_price_cents * line.quantity,request.currency)}</span>
          </li>
        ))}
      </ul>
      <p class="mt-3 border-t border-gray-200 pt-3 font-semibold">
        Product subtotal: {formatPrice(request.subtotal_cents,request.currency)}
      </p>
      <p class="mt-2 text-xs text-gray-500">Final total is subject to confirmed delivery fees. No funds recorded.</p>
    </section>
  </div>
  <section class="mt-6 rounded-lg border border-gray-200 bg-white p-5">
    <h2 class="text-lg font-semibold">Prepare an offline quote</h2>
    <p class="mt-2 text-sm text-gray-600">
      Confirm the actual delivery fee and any discount before asking for payment.
      {isHeld
        ? 'This quote is locked while the associated stock hold is active. Release the hold to revise it.'
        : 'This prepares an internal quote only: no stock is held and no payment is recorded.'}
      No message is automatically sent. Share the agreed final amount with the customer personally.
    </p>
    {quoteSaved && <p class="mt-3 rounded-md bg-green-50 p-3 text-sm text-green-800" role="status">Quote saved to the audit history.</p>}
    {quote && (
      <div class="mt-4 rounded-md bg-gray-50 p-4 text-sm">
        <p class="font-semibold">Latest prepared quote · Revision {quote.revision}</p>
        <p>Product subtotal: {formatPrice(quote.subtotal_cents,request.currency)}</p>
        <p>Delivery fee: {formatPrice(quote.delivery_fee_cents,request.currency)}</p>
        <p>Discount: {formatPrice(quote.discount_cents,request.currency)}</p>
        <p class="mt-2 text-lg font-bold">Proposed total: {formatPrice(quote.total_cents,request.currency)}</p>
        <p class="mt-1 text-xs text-gray-500">Prepared by {quote.updated_by}. Not yet a stock reservation or verified sale.</p>
      </div>
    )}
    <form method="POST" action={'/api/admin/order-requests/' + request.public_id}
      class="mt-4 grid gap-4 sm:grid-cols-2">
      <input type="hidden" name="_action" value="save_quote" />
      <input type="hidden" name="quote_nonce" value={crypto.randomUUID()} />
      <input type="hidden" name="quote_revision" value={quote?.revision ?? 0} />
      <p class="sm:col-span-2 text-sm">
        Frozen product subtotal: <strong>{formatPrice(request.subtotal_cents,request.currency)}</strong>.
        Item prices remain unchanged in this quote.
      </p>
      <label class="block text-sm">Fulfillment
        <select name="fulfillment_method" disabled={request.status === 'cancelled' || isHeld} class="mt-1 block w-full rounded-md border border-gray-300 px-3 py-2">
          <option value="delivery" selected={quote?.fulfillment_method !== 'pickup'}>Delivery</option>
          <option value="pickup" selected={quote?.fulfillment_method === 'pickup'}>Customer pickup</option>
        </select>
      </label>
      <label class="block text-sm">Delivery fee (K)
        <input type="text" inputmode="decimal" name="delivery_fee" required
          value={((quote?.delivery_fee_cents ?? 0)/100).toFixed(2)}
          disabled={request.status === 'cancelled' || isHeld}
          class="mt-1 block w-full rounded-md border border-gray-300 px-3 py-2" />
      </label>
      <label class="block text-sm">Discount (K)
        <input type="text" inputmode="decimal" name="discount" required
          value={((quote?.discount_cents ?? 0)/100).toFixed(2)}
          disabled={request.status === 'cancelled' || isHeld}
          class="mt-1 block w-full rounded-md border border-gray-300 px-3 py-2" />
      </label>
      <label class="block text-sm sm:col-span-2">Delivery/pickup arrangements
        <textarea name="delivery_details" maxlength="500" rows="2"
          disabled={request.status === 'cancelled' || isHeld}
          class="mt-1 block w-full rounded-md border border-gray-300 px-3 py-2">{quote?.delivery_details ?? ''}</textarea>
      </label>
      <label class="block text-sm sm:col-span-2">Internal quote note (not sent automatically)
        <textarea name="quote_note" maxlength="1000" rows="2"
          disabled={request.status === 'cancelled' || isHeld}
          class="mt-1 block w-full rounded-md border border-gray-300 px-3 py-2">{quote?.owner_note ?? ''}</textarea>
      </label>
      <button type="submit" disabled={request.status === 'cancelled' || isHeld}
        class="rounded-md bg-brand px-5 py-2 text-sm font-semibold text-white disabled:opacity-50 sm:col-span-2">
        {quote ? 'Update prepared quote' : 'Prepare quote'}
      </button>
    </form>
    {quoteHistory.length > 0 && (
      <details class="mt-5 border-t border-gray-100 pt-3 text-sm">
        <summary class="cursor-pointer font-medium">Quote revision history ({quoteHistory.length} shown)</summary>
        <ul class="mt-3 space-y-2">
          {quoteHistory.map(entry => (
            <li class="rounded-md border border-gray-100 p-3">
              Revision {entry.revision} · {formatPrice(entry.total_cents,request.currency)}
              · {entry.fulfillment_method} · {entry.changed_by}
            </li>
          ))}
        </ul>
      </details>
    )}
  </section>
  <section class="mt-6 rounded-lg border border-gray-200 bg-white p-5">
    <h2 class="text-lg font-semibold">Stock allocated to this customer</h2>
    {holdSaved && <p role="status" class="mt-3 rounded-md bg-green-50 p-3 text-sm text-green-900">Stock allocation recorded. The request remains unpaid.</p>}
    {holdReleased && <p role="status" class="mt-3 rounded-md bg-green-50 p-3 text-sm text-green-900">Stock has been returned to inventory. No paid order was created.</p>}
    {isHeld ? (
      <>
        <p class="mt-3 text-sm text-amber-900">
          <strong>Held, not paid.</strong> Stock was set aside by {allocation?.held_by}
          {allocation?.held_at ? ' on ' + formatDate(allocation.held_at,undefined,timeZone) : ''}.
          Do not record a sale until cash or transferred funds have actually been verified.
        </p>
        <p class="mt-2 text-xs text-gray-600">Quote revision: {allocation?.quote_revision}. Price changes and cancellation are blocked while this hold exists.</p>
        <form method="POST" action={'/api/admin/order-requests/' + request.public_id} class="mt-4 space-y-3">
          <input type="hidden" name="_action" value="release_hold" />
          <label class="block text-sm font-medium">Reason for returning stock to inventory
            <textarea name="release_reason" required minlength="4" maxlength="500" rows="2"
              placeholder="e.g. Customer cancelled the delivery"
              class="mt-1 block w-full rounded-md border border-gray-300 px-3 py-2"></textarea>
          </label>
          <button type="submit" class="rounded-md border border-amber-600 px-4 py-2 text-sm font-semibold text-amber-900">Release held stock</button>
        </form>
      </>
    ) : allocation?.status === 'released' ? (
      <p class="mt-3 text-sm text-gray-700">
        This request's stock was released by {allocation.released_by}.
        Reason: {allocation.release_reason}. To avoid ambiguity, one request cannot be allocated twice;
        ask the customer to submit a fresh request if they want to proceed again.
      </p>
    ) : quote && request.status !== 'cancelled' ? (
      <>
        <p class="mt-3 text-sm text-gray-700">
          Once the buyer has agreed to the current quote and you have checked the order,
          you can reserve the exact requested items. Inventory is deducted from sellable stock
          immediately; online checkout sees the reduced quantities.
        </p>
        <form method="POST" action={'/api/admin/order-requests/' + request.public_id} class="mt-4 space-y-4">
          <input type="hidden" name="_action" value="hold_stock" />
          <input type="hidden" name="hold_revision" value={quote.revision} />
          <input type="hidden" name="hold_nonce" value={crypto.randomUUID()} />
          <label class="flex items-start gap-3 text-sm">
            <input type="checkbox" name="buyer_confirmed" value="yes" required class="mt-1" />
            <span>I've contacted the buyer, confirmed their agreement to the final quote
              of <strong>{formatPrice(quote.total_cents,request.currency)}</strong>,
              and verified the intended fulfillment arrangement.</span>
          </label>
          <button type="submit" disabled={request.status === 'new'}
            class="rounded-md bg-brand px-4 py-2 text-sm font-semibold text-white disabled:opacity-50">
            Allocate stock for this request
          </button>
          {request.status === 'new' && <p class="text-xs text-amber-800">Mark the customer as contacted before allocating inventory.</p>}
        </form>
      </>
    ) : (
      <p class="mt-3 text-sm text-gray-600">Prepare a quote and contact the buyer before allocating any stock.</p>
    )}
    <p class="mt-4 text-xs text-gray-500">
      Holds currently have no automatic expiry. Release manually if the buyer abandons
      the request. This is not a payment or receipt.
    </p>
  </section>
  <section class="mt-6 rounded-lg border border-gray-200 bg-white p-5">
    <h2 class="text-lg font-semibold">Follow-up status</h2>
    <form method="POST" action={'/api/admin/order-requests/' + request.public_id} class="mt-4 space-y-4">
      <input type="hidden" name="expected_status" value={request.status} />
      <label class="block text-sm">Update status
        <select name="status" class="mt-1 block w-full max-w-xs rounded-md border border-gray-300 px-3 py-2" disabled={request.status === 'cancelled'}>
          <option value="contacted" selected={request.status === 'contacted' || request.status === 'new'}>Customer contacted</option>
          <option value="awaiting_payment" selected={request.status === 'awaiting_payment'}>Awaiting payment or delivery/handover</option>
          <option value="cancelled" selected={request.status === 'cancelled'} disabled={isHeld}>Cancelled / unavailable (release stock first)</option>
        </select>
      </label>
      <label class="block text-sm">Internal note (not visible to the customer)
        <textarea name="operator_note" maxlength="1000" rows="3"
          class="mt-1 block w-full rounded-md border border-gray-300 px-3 py-2"
        >{request.operator_note ?? ''}</textarea>
      </label>
      <button type="submit" disabled={request.status === 'cancelled'}
        class="rounded-md bg-brand px-5 py-2 font-semibold text-white disabled:opacity-50">
        Save follow-up
      </button>
    </form>
  </section>
  <section class="mt-6 rounded-lg border border-gray-200 p-5">
    <h2 class="text-lg font-semibold">When payment is actually received</h2>
    {isHeld ? (
      <p class="mt-2 rounded-md border border-amber-300 bg-amber-50 p-4 text-sm text-amber-900">
        <strong>Important:</strong> This request's inventory has already been deducted
        from sellable stock. Do NOT separately record the same items using the paid
        manual-sale form: doing so would deduct them a second time.
        Verified payment conversion for stock-held requests is the next backend phase.
        Keep independent proof of any money received and do not release the hold
        to make a second sale without first reconciling the customer order.
      </p>
    ) : (
      <>
        <p class="mt-2 text-sm text-gray-600">
          Only after independently verifying cash or transferred funds may a
          separate paid manual sale be recorded. This request is not automatically
          linked to that sale; ensure the same items are not sold or deducted twice.
        </p>
        <a href="/admin/orders/new" class="mt-3 inline-block text-brand underline">Record a verified paid manual sale</a>
      </>
    )}
  </section>
</AdminLayout>
