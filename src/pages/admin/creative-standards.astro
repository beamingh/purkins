---
import { env } from 'cloudflare:workers';
import AdminLayout from '../../layouts/AdminLayout.astro';
import MediaPicker from '../../features/media/MediaPicker.astro';
import { getConfig } from '../../config';
import { listCategories } from '../../features/categories/db';
import {
  DOMAINS, SCOPES, DEFAULT_PRESETS, normalizeCreativeKey, getCreativeRule,
  getCreativeVersions, getCreativeVersion, saveCreativeRule,
  ruleConfig, ruleReferences, referencePhotos, effectiveCreativeRule,
  type CreativeConfig,
} from '../../features/creative/standards';

let error = '';
const params = Astro.url.searchParams;
let domain = params.get('domain') || 'photography';
let scope = params.get('scope') || 'global';
let target = params.get('target_id') || '';
let saved = params.has('saved');

if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  domain = String(f.get('domain') || 'photography');
  scope = String(f.get('scope') || 'global');
  target = String(f.get('target_id') || '').trim();
  try {
    const key = normalizeCreativeKey(domain, scope, target);
    const expected = Number(f.get('expected_revision') ?? 0);
    if (!Number.isInteger(expected) || expected < 0) throw new Error('Invalid revision. Reload the form.');
    const action = String(f.get('_action') || 'save');
    let rules: CreativeConfig;
    let references: string[];
    let active: boolean;
    if (action === 'restore') {
      const revision = Number(f.get('restore_revision'));
      if (!Number.isInteger(revision) || revision < 1) throw new Error('Choose a valid history revision.');
      const historical = await getCreativeVersion(env.DB, key, revision);
      if (!historical) throw new Error('History revision was not found.');
      rules = ruleConfig(historical);
      references = ruleReferences(historical);
      active = historical.active === 1;
    } else if (action === 'save') {
      rules = {};
      const field = (name: string) => String(f.get(name) ?? '').trim();
      const textFields = ['title','instructions','aspect_ratio','background','accuracy_notes','preferred_preset'] as const;
      for (const name of textFields) {
        const value = field(name);
        if (value) rules[name] = value;
      }
      for (const name of ['target_width','target_height'] as const) {
        const value = field(name);
        if (value) rules[name] = Number(value);
      }
      if (field('composite_allowed') === 'yes') rules.composite_allowed = true;
      if (field('composite_allowed') === 'no') rules.composite_allowed = false;
      const shots = field('required_shots').split('\n').map(x => x.trim()).filter(Boolean);
      if (shots.length) rules.required_shots = shots;
      references = field('reference_ids').split(/[\s,]+/).filter(Boolean);
      active = f.get('active') === 'on';
    } else throw new Error('Unknown action.');
    await saveCreativeRule(env.DB, {...key,rules,reference_ids:references,active,
      expected_revision:expected,request_id:crypto.randomUUID(),actor:'admin:creative-standards'});
    const q = new URLSearchParams({domain:key.domain,scope:key.scope,target_id:key.target_id,saved:'1'});
    return Astro.redirect('/admin/creative-standards?'+q.toString(),303);
  } catch (e) { error = e instanceof Error ? e.message : 'Could not save standards.'; }
}

let selectedKey;
try { selectedKey = normalizeCreativeKey(domain,scope,target); }
catch { domain='photography';scope='global';target='';selectedKey=normalizeCreativeKey(domain,scope,target);
  if (!error) error='Choose an existing product, category or a valid preset slug.'; }
const key=selectedKey;
const [current,history,categories,productRows] = await Promise.all([
  getCreativeRule(env.DB,key),
  getCreativeVersions(env.DB,key),
  listCategories(env.DB),
  env.DB.prepare('SELECT name,public_id FROM products WHERE public_id IS NOT NULL ORDER BY name COLLATE NOCASE LIMIT 350')
    .all<{name:string;public_id:string}>(),
]);
const rules = ruleConfig(current);
const references = ruleReferences(current);
const photoOrigin = env.STOREFRONT_URL || Astro.url.origin;
const photos = await referencePhotos(env.DB,references,photoOrigin);
let effective = null;
try {
  effective = await effectiveCreativeRule(env.DB, {
    domain:key.domain,
    ...(key.scope==='product'?{product_id:key.target_id}:{}),
    ...(key.scope==='category'?{category_id:key.target_id}:{}),
    ...(key.scope==='preset'?{preset:key.target_id}:{}),
    origin:photoOrigin,
  });
} catch { /* invalid or deleted selection: still allow editor with validation */ }
const input = 'w-full rounded-md border border-line bg-white px-3 py-2 text-sm text-ink';
const label = 'mb-1 block text-sm font-semibold';
const setIf = (v: unknown) => v ?? '';
const site = getConfig().storeName;
const pageUrl = '/admin/creative-standards';
---
<AdminLayout title="Creative Standards" active="creative">
  <div class="mb-7 space-y-2">
    <h1 class="font-serif text-3xl tracking-tight">Creative Standards</h1>
    <p class="max-w-3xl text-sm text-muted">Private brand instructions for Admin and authorised MCP assistants. Global rules are inherited by presets, category rules and product-specific overrides. The latest saved version is authoritative.</p>
  </div>
  {error && <p role="alert" class="mb-5 rounded-md border border-red-300 bg-red-50 p-3 text-sm text-red-800">{error}</p>}
  {saved && !error && <p role="status" class="mb-5 rounded-md border border-green-200 bg-green-50 p-3 text-sm text-green-800">Standards saved. Your MCP reads will use the new revision after deployment.</p>}

  <form method="get" action={pageUrl} class="mb-6 grid gap-3 rounded-lg border border-line bg-surface p-4 sm:grid-cols-2">
    <div>
      <label class={label} for="select-domain">Standard type</label>
      <select id="select-domain" name="domain" class={input}>
        {DOMAINS.map(d => <option value={d} selected={domain===d}>{d==='social'?'Social posts':d[0].toUpperCase()+d.slice(1)}</option>)}
      </select>
    </div>
    <div>
      <label class={label} for="select-scope">Level</label>
      <select id="select-scope" name="scope" class={input}>
        {SCOPES.map(s => <option value={s} selected={scope===s}>{s[0].toUpperCase()+s.slice(1)}</option>)}
      </select>
    </div>
    <div class="sm:col-span-2">
      <label class={label} for="select-target">Target ID (leave blank for global rules)</label>
      <input id="select-target" name="target_id" list="creative-targets" class={input} value={target} placeholder="Preset slug, cat_… or prod_…" />
      <datalist id="creative-targets">
        {DEFAULT_PRESETS.map(id => <option value={id}>Preset: {id}</option>)}
        {categories.filter(c=>c.public_id).map(c => <option value={c.public_id!}>Category: {c.name}</option>)}
        {(productRows.results??[]).map(p => <option value={p.public_id}>Product: {p.name}</option>)}
      </datalist>
      <p class="mt-1 text-xs text-muted">Select a reference from the suggestions or paste its exact ID. Presets use slugs such as studio-product.</p>
    </div>
    <div class="sm:col-span-2"><button class="rounded-md bg-ink px-4 py-2 text-sm font-semibold text-white">Load standards</button></div>
  </form>

  <div class="grid gap-6 xl:grid-cols-[minmax(0,1fr)_17rem]">
    <div>
      <form method="post" class="space-y-5 rounded-lg border border-line bg-white/60 p-5">
        <input type="hidden" name="_action" value="save" />
        <input type="hidden" name="domain" value={domain}/>
        <input type="hidden" name="scope" value={scope}/>
        <input type="hidden" name="target_id" value={target}/>
        <input type="hidden" name="expected_revision" value={current?.revision??0}/>
        <div class="flex items-center justify-between gap-3">
          <div>
            <h2 class="font-semibold">Edit {scope} {domain} standards</h2>
            <p class="text-xs text-muted">Revision {current?.revision??'new'} · Changes are kept in history</p>
          </div>
          <label class="flex items-center gap-2 text-sm"><input type="checkbox" name="active" checked={current?.active!==0}/> Active</label>
        </div>
        <div>
          <label class={label} for="title">Name (optional)</label>
          <input id="title" name="title" value={setIf(rules.title)} class={input} maxlength="600"/>
        </div>
        <div>
          <label class={label} for="instructions">Creative instructions</label>
          <textarea id="instructions" name="instructions" rows="7" class={input} maxlength="5000" placeholder="Brand rules, composition, text, framing, lighting…">{rules.instructions??''}</textarea>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class={label} for="ratio">Aspect ratio</label><input id="ratio" name="aspect_ratio" class={input} placeholder="4:5" value={setIf(rules.aspect_ratio)}/></div>
          <div><label class={label} for="preset">Preferred preset</label><input id="preset" name="preferred_preset" list="creative-presets" class={input} value={setIf(rules.preferred_preset)} placeholder="studio-product" /><datalist id="creative-presets">{DEFAULT_PRESETS.map(p=><option value={p}/>)}</datalist></div>
          <div><label class={label} for="target-width">Target width (px)</label><input id="target-width" type="number" min="64" max="8000" name="target_width" class={input} value={setIf(rules.target_width)}/></div>
          <div><label class={label} for="target-height">Target height (px)</label><input id="target-height" type="number" min="64" max="8000" name="target_height" class={input} value={setIf(rules.target_height)}/></div>
        </div>
        <div><label class={label} for="background">Background</label><input id="background" class={input} name="background" value={setIf(rules.background)} placeholder="White studio or approved Purkins kitchen"/></div>
        <div>
          <label class={label} for="composite">Feature composites</label>
          <select id="composite" name="composite_allowed" class={input}>
            <option value="" selected={rules.composite_allowed===undefined}>Inherit</option>
            <option value="yes" selected={rules.composite_allowed===true}>Allowed</option>
            <option value="no" selected={rules.composite_allowed===false}>Not allowed</option>
          </select>
        </div>
        <div><label class={label} for="shots">Required shots (one per line)</label><textarea id="shots" name="required_shots" rows="3" class={input} placeholder="Full product&#10;Key features&#10;Realistic use">{(rules.required_shots??[]).join('\n')}</textarea></div>
        <div><label class={label} for="accuracy">Product fidelity and label notes</label><textarea id="accuracy" name="accuracy_notes" rows="4" class={input} placeholder="Exact colours, label wording, zippers, controls and features to preserve">{rules.accuracy_notes??''}</textarea></div>
        <div class="space-y-2">
          <label class={label} for="refs">Approved reference images (media IDs)</label>
          <textarea id="refs" name="reference_ids" rows="2" class={input} data-creative-media-ids placeholder="med_… IDs separated by commas or lines">{references.join('\n')}</textarea>
          <MediaPicker id="creative-standard-reference" label="Select from Media Library" />
          <p class="text-xs text-muted">Only approved library images. Up to 12 per rule; selection adds their med_ IDs. Files stay in R2. Referenced files cannot be deleted accidentally.</p>
          {photos.length>0 && <div class="grid grid-cols-3 gap-3 sm:grid-cols-5">
            {photos.map(p=><figure class="space-y-1"><img class="aspect-[4/5] w-full rounded border border-line object-contain" loading="lazy" src={p.image_path} alt={p.name}/><figcaption class="truncate text-xs text-muted" title={p.name}>{p.name}</figcaption></figure>)}
          </div>}
        </div>
        <button type="submit" class="rounded-md bg-brand px-5 py-3 text-sm font-semibold text-white hover:bg-brand-hover">Save creative standards</button>
      </form>
    </div>
    <aside class="space-y-5">
      <section class="rounded-lg border border-line p-4">
        <h2 class="mb-2 font-semibold">How inheritance works</h2>
        <p class="text-sm text-muted">Global → chosen preset → category → product. A field is overridden only if that level sets it. Approved images from each applicable level are included together.</p>
        <p class="mt-3 text-xs text-muted">Photography is private guidance, not an automatic image converter. Product-gallery publication still needs owner review.</p>
      </section>
      {effective && <section class="rounded-lg border border-line p-4">
        <h2 class="mb-2 font-semibold">Current effective rules</h2>
        <pre class="max-h-96 overflow-auto whitespace-pre-wrap break-words rounded-md bg-surface p-3 text-xs">{JSON.stringify(effective.rules,null,2)}</pre>
        <p class="mt-2 text-xs text-muted">{effective.reference_images.length} approved images across {effective.sources.length} active levels</p>
      </section>}
      <section class="rounded-lg border border-line p-4">
        <h2 class="mb-2 font-semibold">Version history</h2>
        {history.length===0?<p class="text-sm text-muted">No saved versions yet.</p>:<ul class="space-y-3">
          {history.map(v=><li class="border-b border-line pb-3 text-xs">
            <p class="font-semibold">Revision {v.revision} {v.active?'· Active':'· Disabled'}</p>
            <p class="text-muted">{v.created_at} · {v.updated_by}</p>
            {current && v.revision!==current.revision &&
              <form method="post" class="mt-1">
                <input type="hidden" name="_action" value="restore"/>
                <input type="hidden" name="domain" value={domain}/>
                <input type="hidden" name="scope" value={scope}/>
                <input type="hidden" name="target_id" value={target}/>
                <input type="hidden" name="expected_revision" value={current.revision}/>
                <input type="hidden" name="restore_revision" value={v.revision}/>
                <button class="text-brand underline" type="submit">Restore as new revision</button>
              </form>}
          </li>)}
        </ul>}
      </section>
    </aside>
  </div>
  <p class="mt-5 text-xs text-muted">Store: {site}. Reference photo URLs and approved creative briefs are available through the owner-only MCP tools after migration and deployment.</p>
</AdminLayout>
<script>
  // The media dialog dispatches only med_ IDs, never arbitrary external URLs.
  document.addEventListener('media:selected',(event)=>{
    const data=(event as CustomEvent<{id?:string}>).detail;
    const field=document.querySelector<HTMLTextAreaElement>('[data-creative-media-ids]');
    if(!field||!data?.id?.startsWith('med_'))return;
    const previous=field.value.split(/[\s,]+/).map(s=>s.trim()).filter(Boolean);
    if(!previous.includes(data.id))field.value=[...previous,data.id].join('\n');
  });
</script>
