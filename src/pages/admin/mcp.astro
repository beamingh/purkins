---
import { env } from 'cloudflare:workers';
import AdminLayout from '../../layouts/AdminLayout.astro';
import { authorizedMcpOwner } from '../../features/mcp/ownerGate';
import {
  MCP_TOOL_PERMISSIONS, MCP_ALL_TOOLS, MCP_OWNER_READ_TOOLS, parseStoredMcpPermissions,
} from '../../features/mcp/clientScope';
import {
  issueMcpClientToken, revokeMcpClientToken, listMcpClientTokens,
  listMcpClientTokenEvents, MCP_CLIENT_TOKEN_DAYS,
} from '../../features/mcp/clientTokens';

export const prerender = false;

Astro.response.headers.set('Cache-Control','private, no-store');
// The native POST forms require an accurate Origin for the middleware CSRF
// check. Referrer-Policy: no-referrer can cause browsers to send Origin: null
// on navigate-mode form submissions. same-origin hides referrers from other
// websites without suppressing Origin for our own form POSTs.
Astro.response.headers.set('Referrer-Policy','same-origin');

const owner=await authorizedMcpOwner(
  Astro.request.headers.get('Cf-Access-Jwt-Assertion'),env,
);
if(!owner) {
  return new Response(
    'MCP connections require the configured owner’s verified Cloudflare Access identity. Check PURKINS_MCP_OWNER_EMAIL and Access JWT settings.',
    {status:403,headers:{'Cache-Control':'no-store','Content-Type':'text/plain; charset=utf-8'}},
  );
}

let revealedToken:string|null=null;
let success='';
let error='';
if(Astro.request.method==='POST'){
  // Defense in depth. Cookie-based Access and Admin auth require a same-origin
  // form submission, not an attacker-controlled cross-site POST.
  if(Astro.request.headers.get('Origin')!==Astro.url.origin){
    error='Cross-origin token changes are forbidden.';
  } else {
    const form=await Astro.request.formData();
    const action=String(form.get('_action')??'');
    try{
      if(action==='create'){
        const issued=await issueMcpClientToken(env.DB,{
          ownerEmail:owner,
          name:String(form.get('name')??''),
          expiryDays:Number(form.get('expires_days')??''),
          requestId:String(form.get('request_id')??''),
          // The full checkbox is a server-side preset as well as a JS shortcut.
          // If a single checkbox is subsequently dropped the browser script
          // clears full_permissions, preserving every individual selection.
          toolPermissions:form.get('full_permissions')==='1'
            ? MCP_ALL_TOOLS
            : form.getAll('tool_permission').map(value=>String(value)),
        });
        if(issued.ok){
          revealedToken=issued.token;
          success='Connection created. Copy its token now; it will not be displayed again.';
        } else error=issued.message;
      }else if(action==='revoke'){
        const revoked=await revokeMcpClientToken(env.DB,{
          id:String(form.get('token_id')??''),ownerEmail:owner,
        });
        if(revoked.ok)success=revoked.message;
        else error=revoked.message;
      }else{
        error='Unknown token-management action.';
      }
    }catch{
      // Do not disclose driver/SQL errors or raw credentials to the browser.
      error='Token management could not complete. Check Worker logs; retry creation with a new request ID only after checking the token list.';
    }
  }
}

const connections=await listMcpClientTokens(env.DB);
const events=await listMcpClientTokenEvents(env.DB);
const now=Math.floor(Date.now()/1000);
const status=(row:typeof connections[number])=>row.revoked_at!==null?'Revoked':row.expires_at<=now?'Expired':'Active';
const format=(seconds:number|null)=>seconds===null?'Never':new Date(seconds*1000).toLocaleString('en-ZM',{
  timeZone:'Africa/Lusaka',day:'2-digit',month:'short',year:'numeric',hour:'2-digit',minute:'2-digit',
});
const requestId=crypto.randomUUID();
const permissionGroups=[...new Set(MCP_TOOL_PERMISSIONS.map(item=>item.group))];
const defaultTools=new Set<string>(MCP_OWNER_READ_TOOLS);
const mcpEndpoint=`${Astro.url.origin}/mcp`;
const oneTimeConnectionUrl = revealedToken
  ? mcpEndpoint+'?token='+encodeURIComponent(revealedToken) : null;
---

<AdminLayout title="MCP connections" active="mcp">
  <header class="mb-8">
    <p class="mb-2 text-xs uppercase tracking-widest text-gray-500">Private / Owner only</p>
    <h1 class="font-serif text-3xl">MCP connections &amp; tokens</h1>
    <p class="mt-3 max-w-2xl text-sm leading-relaxed text-gray-600">
      Create expiring, owner-controlled credentials with precisely selected MCP permissions.
      New connections start with safe, read-only access. Select <strong>Full permissions</strong>
      or add and remove individual tools for stock intake, media, locations and other operations.
      Worker-level write safeguards, confirmation and audit requirements still apply.
    </p>
  </header>

  {success && <p role="status" class="mb-5 rounded-md border border-green-300 bg-green-50 px-4 py-3 text-sm text-green-900">{success}</p>}
  {error && <p role="alert" class="mb-5 rounded-md border border-red-300 bg-red-50 px-4 py-3 text-sm text-red-900">{error}</p>}

  {revealedToken && (
    <section class="mb-8 rounded-lg border-2 border-amber-400 bg-amber-50 p-5" aria-labelledby="one-time-title">
      <h2 id="one-time-title" class="font-serif text-xl">Your token — visible only once</h2>
      <p class="mt-2 text-sm text-amber-900">
        Copy it now and store it privately. Never post it in chat or commit it to Git. The combined connection URL below is also a secret; anyone who obtains it can use its granted tools until expiry or revocation.
        Reloading this page will hide it permanently; if it is lost, revoke it and generate another.
      </p>
      <div class="mt-4 flex flex-col gap-3">
        <label for="mcp-one-time-token" class="text-xs font-semibold uppercase tracking-wide">Bearer token</label>
        <textarea id="mcp-one-time-token" readonly rows="3" spellcheck="false"
          class="w-full resize-none break-all rounded border border-amber-300 bg-white p-3 font-mono text-xs">{revealedToken}</textarea>
        <button type="button" id="copy-mcp-token"
          class="self-start rounded-md bg-gray-900 px-4 py-2 text-sm font-medium text-white">
          Copy token
        </button>
        {oneTimeConnectionUrl&&(
          <>
            <label for="mcp-one-time-url" class="text-xs font-semibold uppercase tracking-wide">Combined MCP connection URL</label>
            <textarea id="mcp-one-time-url" readonly rows="4" spellcheck="false"
              class="w-full resize-none break-all rounded border border-amber-300 bg-white p-3 font-mono text-xs">{oneTimeConnectionUrl}</textarea>
            <button type="button" id="copy-mcp-url"
              class="self-start rounded-md bg-gray-900 px-4 py-2 text-sm font-medium text-white">
              Copy connection URL
            </button>
          </>
        )}
      </div>
    </section>
  )}

  <section class="mb-8 rounded-lg border border-line bg-white p-5" aria-labelledby="endpoint-title">
    <h2 id="endpoint-title" class="font-serif text-xl">Connection details</h2>
    <dl class="mt-4 grid gap-3 text-sm">
      <div><dt class="font-semibold">MCP endpoint</dt><dd class="mt-1 break-all font-mono text-xs">{mcpEndpoint}</dd></div>
      <div><dt class="font-semibold">Authentication</dt><dd class="mt-1">For compatible MCP clients: ?token=&lt;generated pmcp_ token&gt; (Ulwimbo-compatible ?mcp_token= is also supported). Alternatively, Authorization: Bearer &lt;token&gt;. Cloudflare Access protection must permit the MCP route.</dd></div>
      <div><dt class="font-semibold">Client capabilities</dt><dd class="mt-1">Selectable individual MCP tools, with a read-only default and Full permissions shortcut. Write tools also require enabled Worker-level scope switches.</dd></div>
    </dl>
    <p class="mt-4 text-sm text-amber-900">
      Token-in-URL connections do not require OAuth discovery. Treat the full URL like a password:
      avoid sharing it, bookmarking it or using it in a normal browser. Query credentials can
      appear in proxy/access logs. A Cloudflare Access policy protecting the entire Worker
      will still block token-only clients before they reach MCP; that policy must be scoped
      appropriately without exposing the Admin dashboard.
    </p>
  </section>

  <section class="mb-10 rounded-lg border border-line bg-white p-5" aria-labelledby="create-title">
    <h2 id="create-title" class="font-serif text-xl">Create new token</h2>
    <p class="mt-2 text-sm text-gray-600">Only the verified Purkins owner can create or revoke connections.</p>
    <form method="post" action="/admin/mcp" class="mt-5 grid gap-4">
      <input type="hidden" name="_action" value="create" />
      <input type="hidden" name="request_id" value={requestId} />
      <div>
        <label for="token-name" class="mb-1 block text-sm font-medium">Connection name</label>
        <input id="token-name" name="name" required minlength="3" maxlength="120"
          placeholder="ChatGPT — Purkins inventory" autocomplete="off"
          class="w-full rounded-md border border-line bg-white p-3 text-sm" />
      </div>
      <div>
        <label for="token-expiry" class="mb-1 block text-sm font-medium">Expires after</label>
        <select id="token-expiry" name="expires_days"
          class="w-full rounded-md border border-line bg-white p-3 text-sm">
          {MCP_CLIENT_TOKEN_DAYS.map(days=><option value={days} selected={days===90}>{days} days</option>)}
        </select>
      </div>
      <fieldset class="rounded-lg border border-line p-4" id="mcp-permission-editor">
        <legend class="px-2 font-medium">Tool permissions</legend>
        <label class="mt-2 flex cursor-pointer items-center gap-3 rounded-md border border-amber-300 bg-amber-50 p-3">
          <input id="mcp-full-permissions" type="checkbox" name="full_permissions" value="1" class="size-4" />
          <span><strong>Full permissions</strong><small class="block text-gray-700">Select every supported tool. Includes sensitive operations; server-side write protections still apply.</small></span>
        </label>
        <div class="my-3 flex flex-wrap items-center justify-between gap-2">
          <p id="mcp-selected-count" aria-live="polite" class="text-xs text-gray-600">Safe default: {MCP_OWNER_READ_TOOLS.length} read-only tools</p>
          <button id="mcp-reset-readonly" type="button" class="rounded border border-line px-3 py-2 text-xs hover:bg-gray-100">Restore safe default</button>
        </div>
        {permissionGroups.map(group=>(
          <details class="mt-3 rounded-md border border-line bg-gray-50 p-3" open={group==='Private catalog reads'||group==='Guarded stock drafts'}>
            <summary class="cursor-pointer text-sm font-semibold">{group}</summary>
            <div class="mt-3 grid gap-3 sm:grid-cols-2">
              {MCP_TOOL_PERMISSIONS.filter(tool=>tool.group===group).map(tool=>(
                <label class="flex cursor-pointer items-start gap-2 text-sm">
                  <input type="checkbox" name="tool_permission" value={tool.name}
                    data-mcp-permission={tool.name}
                    data-default-read={tool.safety==='read'?'1':'0'}
                    checked={defaultTools.has(tool.name)}
                    class="mt-1 size-4 shrink-0" />
                  <span><strong class="block text-xs">{tool.label}</strong>
                    <code class="block break-all text-[0.68rem] text-gray-500">{tool.name}</code>
                    {tool.safety!=='read'&&<small class="text-amber-800">Write access · {tool.safety==='legacy'?'legacy gate':tool.safety==='commerce'?'commerce': 'guarded'}</small>}
                  </span>
                </label>
              ))}
            </div>
          </details>
        ))}
        <p class="mt-4 text-xs text-gray-600">
          Grants are fixed when a token is issued. To change them, issue a replacement token
          and revoke the old one. An existing MCP session cannot silently keep removed permissions.
          Full access never overrides emergency write-disable flags or required confirmations.
        </p>
      </fieldset>
      <p class="text-xs text-gray-600">Accountable owner: {owner}. The current global write switch remains independent of token grants.</p>
      <button type="submit" class="self-start rounded-md bg-gray-900 px-5 py-3 text-sm font-medium text-white">
        Generate one-time token
      </button>
    </form>
  </section>

  <section class="mb-10 rounded-lg border border-line bg-white p-5" aria-labelledby="tools-title">
    <h2 id="tools-title" class="font-serif text-xl">Available MCP tool registry</h2>
    <p class="mt-2 text-sm text-gray-600">
      {MCP_OWNER_READ_TOOLS.length} safe read tools · {MCP_ALL_TOOLS.length-MCP_OWNER_READ_TOOLS.length} additional write tools.
      Each connection receives only the tools you select; the global Worker switches may restrict write access further.
    </p>
  </section>

  <section class="mb-10" aria-labelledby="list-title">
    <h2 id="list-title" class="mb-3 font-serif text-2xl">Existing connections</h2>
    <div class="overflow-x-auto rounded-lg border border-line bg-white">
      <table class="w-full min-w-[650px] text-left text-sm">
        <thead class="border-b border-line bg-gray-50 text-xs uppercase tracking-wide text-gray-600">
          <tr><th class="p-3">Connection</th><th class="p-3">Status</th><th class="p-3">Expiry</th><th class="p-3">Last used</th><th class="p-3">Calls</th><th class="p-3">Action</th></tr>
        </thead>
        <tbody>
          {connections.map(row=>(
            <tr class="border-b border-line">
              <td class="p-3">
                <strong class="block">{row.name}</strong>
                <code class="text-xs text-gray-500">{row.token_prefix}…</code>
                <span class="block text-xs text-gray-500">{(parseStoredMcpPermissions(row.tool_permissions_json)??[]).length}/{MCP_ALL_TOOLS.length} tools · {row.accountable_email}</span>
                <details class="mt-2 text-xs text-gray-600">
                  <summary class="cursor-pointer">Granted tools</summary>
                  <div class="mt-2 flex flex-wrap gap-1">
                    {(parseStoredMcpPermissions(row.tool_permissions_json)??[]).map(tool=>(
                      <code class="rounded bg-gray-100 px-2 py-1">{tool}</code>
                    ))}
                  </div>
                </details>
                {row.revoked_at===null&&row.expires_at>now&&(
                  <button type="button" data-mcp-copy-permissions={row.id}
                    data-mcp-existing-name={row.name}
                    data-mcp-existing-permissions={JSON.stringify(parseStoredMcpPermissions(row.tool_permissions_json)??[])}
                    class="mt-2 text-xs text-brand underline">Replace with different permissions</button>
                )}
              </td>
              <td class="p-3">{status(row)}</td>
              <td class="p-3 whitespace-nowrap text-xs">{format(row.expires_at)}</td>
              <td class="p-3 whitespace-nowrap text-xs">{format(row.last_used_at)}</td>
              <td class="p-3">{row.call_count}</td>
              <td class="p-3">
                {row.revoked_at===null&&row.expires_at>now ? (
                  <form method="post" action="/admin/mcp" onsubmit="return confirm('Revoke this connection immediately?');">
                    <input type="hidden" name="_action" value="revoke" />
                    <input type="hidden" name="token_id" value={row.id} />
                    <button class="rounded border border-red-400 px-3 py-2 text-xs text-red-700" type="submit">Revoke</button>
                  </form>
                ):<span class="text-xs text-gray-500">—</span>}
              </td>
            </tr>
          ))}
          {connections.length===0&&<tr><td colspan="6" class="p-6 text-center text-sm text-gray-500">No MCP client tokens have been issued.</td></tr>}
        </tbody>
      </table>
    </div>
  </section>

  <section aria-labelledby="audit-title">
    <h2 id="audit-title" class="mb-3 font-serif text-2xl">Credential audit</h2>
    <div class="overflow-x-auto rounded-lg border border-line bg-white">
      <table class="w-full min-w-[450px] text-sm">
        <thead class="border-b border-line bg-gray-50 text-xs uppercase tracking-wide text-gray-600">
          <tr><th class="p-3 text-left">When</th><th class="p-3 text-left">Operation</th><th class="p-3 text-left">Owner</th></tr>
        </thead>
        <tbody>
          {events.map((event)=>(
            <tr class="border-b border-line"><td class="p-3 text-xs">{format(event.occurred_at)}</td><td class="p-3 capitalize">{event.action}</td><td class="p-3 text-xs">{event.actor_email}</td></tr>
          ))}
          {events.length===0&&<tr><td colspan="3" class="p-5 text-center text-gray-500">No credential changes recorded.</td></tr>}
        </tbody>
      </table>
    </div>
  </section>
</AdminLayout>

<script>
  const permissionBoxes=[...document.querySelectorAll<HTMLInputElement>('[name="tool_permission"]')];
  const full=document.getElementById('mcp-full-permissions') as HTMLInputElement|null;
  const count=document.getElementById('mcp-selected-count');
  const updateCount=()=>{
    const selected=permissionBoxes.filter(box=>box.checked).length;
    if(full)full.checked=selected===permissionBoxes.length;
    if(count)count.textContent=`${selected}/${permissionBoxes.length} tools selected`;
  };
  full?.addEventListener('change',()=>{
    permissionBoxes.forEach(box=>{box.checked=!!full.checked;});
    updateCount();
  });
  permissionBoxes.forEach(box=>box.addEventListener('change',updateCount));
  document.getElementById('mcp-reset-readonly')?.addEventListener('click',()=>{
    permissionBoxes.forEach(box=>{box.checked=box.dataset.defaultRead==='1';});
    updateCount();
  });
  document.querySelectorAll<HTMLButtonElement>('[data-mcp-copy-permissions]').forEach(button=>{
    button.addEventListener('click',()=>{
      const selected=new Set(JSON.parse(button.dataset.mcpExistingPermissions??'[]') as string[]);
      permissionBoxes.forEach(box=>{box.checked=selected.has(box.value);});
      const name=document.getElementById('token-name') as HTMLInputElement|null;
      if(name)name.value=(button.dataset.mcpExistingName??'Purkins MCP')+' replacement';
      updateCount();
      document.getElementById('mcp-permission-editor')?.scrollIntoView({behavior:'smooth',block:'start'});
    });
  });
  updateCount();
  document.getElementById('copy-mcp-url')?.addEventListener('click',async()=>{
    const textarea=document.getElementById('mcp-one-time-url') as HTMLTextAreaElement|null;
    if(!textarea)return;
    try{
      await navigator.clipboard.writeText(textarea.value);
      const button=document.getElementById('copy-mcp-url');
      if(button)button.textContent='Copied URL';
    }catch{
      textarea.select();
    }
  });
  document.getElementById('copy-mcp-token')?.addEventListener('click',async()=>{
    const textarea=document.getElementById('mcp-one-time-token') as HTMLTextAreaElement|null;
    if(!textarea)return;
    try{
      await navigator.clipboard.writeText(textarea.value);
      const button=document.getElementById('copy-mcp-token');
      if(button)button.textContent='Copied';
    }catch{
      textarea.select();
    }
  });
</script>
