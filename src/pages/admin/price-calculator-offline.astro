---
import PriceCalculator from '../../features/purkins/PriceCalculator.astro';
// This is a generic offline fallback, with no customer details, inventory or
// authenticated admin HTML cached by the service worker.
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="theme-color" content="#faf8f4" />
    <title>Purkins price calculator (offline)</title>
    <style is:inline>
      html { background:#faf8f4; color:#111827; }
      body { margin:0; padding:1.5rem 1rem 4rem; }
      main { max-width:900px; margin:auto; }
      h1 { font:600 clamp(1.6rem,4vw,2.4rem)/1.25 Georgia,serif; margin:0 0 0.5rem; }
      .intro { font:0.9rem/1.6 system-ui,sans-serif; color:#57534e; margin:0 0 1.5rem; }
    </style>
  </head>
  <body>
    <main>
      <h1>Purkins price calculator</h1>
      <p class="intro">Offline mode. Enter a rand price and use the rate and markup saved on this device.</p>
      <PriceCalculator />
    </main>
  </body>
</html>
