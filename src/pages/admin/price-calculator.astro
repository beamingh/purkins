---
import { env } from 'cloudflare:workers';
import AdminLayout from '../../layouts/AdminLayout.astro';
import PriceCalculator from '../../features/purkins/PriceCalculator.astro';
import ProductDraftFromCalculator from '../../features/purkins/ProductDraftFromCalculator.astro';
import { listLocationTree } from '../../features/purkins/locations';

const locations = await listLocationTree(env.DB);
---
<AdminLayout title="Price calculator" active="pricing">
  <header class="mb-7">
    <p class="mb-2 text-xs uppercase tracking-widest text-gray-500">Purkins / Buying & pricing</p>
    <h1 class="font-serif text-3xl tracking-tight">Price calculator</h1>
    <p class="mt-3 max-w-2xl text-sm leading-relaxed text-gray-600">
      Calculate from Rand or Kwacha cost, adjust overhead and markup instantly,
      and round your selling price. Keep quick calculations in offline history,
      or optionally create a private product draft with the cost and selling
      price already filled in.
    </p>
  </header>
  <div class="space-y-6">
    <PriceCalculator />
    <ProductDraftFromCalculator locations={locations} />
  </div>
</AdminLayout>
