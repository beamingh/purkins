---
import { env } from 'cloudflare:workers';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import ProductForm from '../../../features/products/ProductForm.astro';
import { listCategories, buildTree, flattenTree } from '../../../features/categories/db';
import { zonesRequireWeight } from '../../../features/shipping/calculator';
import { shippingFor } from '../../../features/shipping/effective';

const categoryOptions = flattenTree(buildTree(await listCategories(env.DB)));
const error = Astro.url.searchParams.get('error');
const weightUnit = Astro.locals.settings?.weightUnit ?? 'g';
const weightRequired = zonesRequireWeight(shippingFor(Astro.locals.settings).config);
---

<AdminLayout title="New product" active="products">
  <a href="/admin/products" class="text-sm text-gray-500 hover:text-brand">&larr; Back to products</a>
  <h1 class="mt-4 mb-2 text-2xl font-bold">New Purkins stock item</h1>
  <p class="mb-6 text-sm text-muted">Start with a photo and item name. Save as a private draft, then review the selling price before publishing.</p>
  <ProductForm
    action="/api/admin/products"
    submitLabel="Create product"
    categoryOptions={categoryOptions}
    error={error}
    weightUnit={weightUnit}
    weightRequired={weightRequired}
  />
</AdminLayout>
