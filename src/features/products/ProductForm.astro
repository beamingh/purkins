---
import type { Product } from './db';
import type { CategoryOption } from '../categories/db';
import { getConfig, toMajorUnits, currencyDecimals } from '../../config';
import { formatWeightValue, type WeightUnit } from '../shipping/weight';
import { attachmentActive } from '../digitalDelivery/rollout.ts';
import { landedCostCents, suggestedSellingPriceCents, type IntakeRecord } from '../purkins/intake';
import type { LocationOption } from '../purkins/locations';

interface Props {
  action: string;
  submitLabel: string;
  product?: Product | null;
  intake?: IntakeRecord | null;
  error?: string | null;
  /** Depth-tagged categories to choose from (empty = no categories yet). */
  categoryOptions?: CategoryOption[];
  /** Ids of categories this product currently belongs to. */
  selectedCategoryIds?: number[];
  /** Show the single-image upload (true on create; edit uses the gallery). */
  showImage?: boolean;
  /** Rapid intake uses the existing safe draft-creation route with a next-item flow. */
  intakeDesk?: boolean;
  /** Saved private location paths offered to Admin users only. */
  locationOptions?: LocationOption[];
  initialLocationId?: string | null;
  /** Optional form id, so out-of-tree inputs (e.g. the variants editor) can submit
      with this form via the HTML `form="..."` attribute. */
  formId?: string;
  /** Store-wide weight unit (Admin → Settings). Storage is always grams. */
  weightUnit?: WeightUnit;
  /** True when every enabled zone prices by weight, so a blank weight would make
   *  this product unsellable. Shown as a requirement rather than discovered later. */
  weightRequired?: boolean;
}

const {
  action,
  submitLabel,
  product = null,
  intake = null,
  error = null,
  categoryOptions = [],
  selectedCategoryIds = [],
  showImage = true,
  intakeDesk = false,
  locationOptions = [],
  initialLocationId = null,
  formId,
  weightUnit = 'g',
  weightRequired = false,
} = Astro.props;
const selected = new Set(selectedCategoryIds);
// New products default to the store currency; edits keep their own.
const defaultCurrency = product?.currency ?? getConfig().currency;
const priceDecimals = currencyDecimals(defaultCurrency);
const price = product
  ? toMajorUnits(product.price_cents, product.currency).toFixed(currencyDecimals(product.currency))
  : (0).toFixed(priceDecimals);
const intakeLanded = intake ? landedCostCents(intake) : null;
const intakeSuggested = intake ? suggestedSellingPriceCents(intake) : null;
const intakeEnabled = product === null || intake !== null;
const selectedPricingMode = intake?.pricing_mode ?? (intakeDesk ? 'manual' : 'cost_based');
// Input increment matches the currency's precision: 0.01 (USD), 1 (JPY), 0.001 (BHD).
const priceStep = priceDecimals > 0 ? (10 ** -priceDecimals).toFixed(priceDecimals) : '1';
const inputClass =
  'mt-1 w-full rounded-md border border-line px-3 py-2 focus:border-brand focus:outline-none';
---

<form
  method="POST"
  action={action}
  enctype="multipart/form-data"
  id={formId}
  class="max-w-lg space-y-4"
  data-purkins-intake={intakeEnabled ? '' : undefined}
  data-purkins-desk={intakeDesk ? '' : undefined}
>
  {
    error && (
      <p class="rounded-md border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700">
        {error}
      </p>
    )
  }

    {
    showImage && (
      <div>
        <label class="block text-sm font-medium" for="image">
          Image
        </label>
        <input id="image" name="image" type="file" accept="image/*" class="mt-1 block w-full text-sm text-muted file:mr-3 file:cursor-pointer file:rounded-md file:border-0 file:bg-brand file:px-4 file:py-2 file:text-xs file:font-medium file:uppercase file:tracking-wider file:text-on-brand hover:file:bg-brand-hover" />
      </div>
    )
  }

  {/* These panes are only toggled by the guided Purkins editor. On all other
      product pages they remain visible, preserving one complete form submit. */}
  <div id="editor-pane-details" data-editor-pane="details" class="space-y-4">
  <div>
    <label class="block text-sm font-medium" for="name">Name</label>
    <input id="name" name="name" type="text" required value={product?.name ?? ''} class={inputClass} />
    {intakeDesk && (
      <div data-intake-duplicates hidden class="mt-2 rounded-md border border-line bg-paper px-3 py-2 text-xs">
        <p class="font-semibold">Possible existing stock — check before creating a duplicate</p>
        <ul data-intake-duplicate-list class="mt-1 space-y-1"></ul>
      </div>
    )}
  </div>

  <div>
    <label class="block text-sm font-medium" for="slug">
      Slug <span class="text-faint">(URL — blank to auto-generate from name)</span>
    </label>
    <input
      id="slug"
      name="slug"
      type="text"
      value={product?.slug ?? ''}
      placeholder="auto-from-name"
      class={inputClass}
    />
  </div>

  <div>
    <label class="block text-sm font-medium" for="description">Description</label>
    <textarea id="description" name="description" rows="3" class={inputClass}
      >{product?.description ?? ''}</textarea>
      <p class="mt-1 text-xs text-gray-500">Plain text or Markdown — paragraphs, lists, links, and <code>/images/…</code> media render on the product page.</p>
  </div>

  </div>
  <div id="editor-pane-inventory" data-editor-pane="inventory" class="space-y-4">
  {intakeEnabled && (
    <section class="rounded-lg border border-line bg-surface p-4 space-y-2" aria-label="Selling price method">
      <label class="block text-sm font-semibold" for="pricing_mode">How do you want to price this item?</label>
      <select id="pricing_mode" class={inputClass} name="pricing_mode" data-intake-pricing-mode>
        <option value="manual" selected={selectedPricingMode === 'manual'}>Manual price — enter selling price directly</option>
        <option value="cost_based" selected={selectedPricingMode === 'cost_based'}>Cost-based — calculate from purchase cost and markup</option>
      </select>
      <p data-intake-manual-help class="text-xs text-muted" hidden={selectedPricingMode !== 'manual'}>
        Enter the selling price in kwacha below. Purchase cost, exchange rate, overhead
        and markup are optional. Without those inputs, cost recovery is unknown.
        Publishing still requires a photo, complete condition and your approval.
      </p>
    </section>
  )}

  <div class="grid grid-cols-2 gap-4">
    <div>
      <label class="block text-sm font-medium" for="price">Selling price ({defaultCurrency.toUpperCase()})</label>
      <input id="price" name="price" type="number" step={priceStep} min="0" required value={price} class={inputClass} />
    </div>
    <div>
      <label class="block text-sm font-medium" for="stock">Stock</label>
      <input id="stock" name="stock" type="number" step="1" min="0" value={product?.stock ?? 0} class={inputClass} />
    </div>
  </div>


  {
    intakeEnabled && (
      <fieldset class="rounded-lg border border-line bg-surface p-4 space-y-3">
        <legend class="px-2 text-sm font-semibold">Purkins stock intake</legend>
        <p class="text-xs text-muted">New products are private drafts. Private stock and cost details are accessible to the current admin login only; do not share that login with a partner until separate roles are implemented.</p>
        {intake && <p class="text-sm">Item code: <strong>{intake.sku}</strong> · Price review: <strong>{intake.status === 'approved' ? 'Approved' : 'Draft'}</strong></p>}
        <div class="grid gap-3 sm:grid-cols-2">
          <label class="text-sm">Brand
            <input class={inputClass} name="brand" maxlength="100" value={intake?.brand ?? ''} placeholder="Little Castle, Real Baby…" />
          </label>
          <label class="text-sm">Supplier barcode / label code
            <input class={inputClass} name="supplier_barcode" maxlength="80" value={intake?.supplier_barcode ?? ''} placeholder="Preserves leading zeroes" />
          </label>
          <label class="text-sm">Size
            <input class={inputClass} name="size_label" maxlength="60" value={intake?.size_label ?? ''} placeholder="0–3 months" />
          </label>
          <label class="text-sm">Colour
            <input class={inputClass} name="colour" maxlength="60" value={intake?.colour ?? ''} placeholder="Cream" />
          </label>
          <label class="text-sm">Age range
            <input class={inputClass} name="age_range" maxlength="60" value={intake?.age_range ?? ''} placeholder="Newborn" />
          </label>
          <label class="text-sm sm:col-span-2">Storage location (private)
            <select class={inputClass} name="location_id" data-intake-existing-location>
              <option value="" selected={!(intake?.location_id ?? initialLocationId)}>Unassigned — choose a location</option>
              {locationOptions.map((location) => (
                <option value={location.id} selected={location.id === (intake?.location_id ?? initialLocationId)}>{location.path}</option>
              ))}
            </select>
          </label>
          <details class="rounded-md border border-line bg-paper p-3 sm:col-span-2" data-intake-new-location>
            <summary class="cursor-pointer text-sm font-medium text-brand">+ Create a new location or child container</summary>
            <div class="mt-3 grid gap-3 sm:grid-cols-2">
              <label class="text-sm sm:col-span-2">New location name
                <input class={inputClass} name="storage_location_new" maxlength="100" placeholder="e.g. Blue PEP Bag" />
              </label>
              <label class="text-sm">Type
                <select class={inputClass} name="storage_location_kind">
                  <option value="other">Other</option><option value="site">Site</option>
                  <option value="room">Room</option><option value="shelf">Shelf</option>
                  <option value="sack">Sack</option><option value="bag">Bag</option>
                  <option value="bin">Bin</option>
                </select>
              </label>
              <label class="text-sm">Inside (parent)
                <select class={inputClass} name="storage_location_parent_id">
                  <option value="">Top level</option>
                  {locationOptions.map((location) => (<option value={location.id}>{location.path}</option>))}
                </select>
              </label>
            </div>
            <p class="mt-2 text-xs text-muted">A new location is saved with this item. Moving its parent later updates the displayed path of everything inside, without changing item references.</p>
          </details>
          <p class="text-xs sm:col-span-2"><a href="/admin/locations" class="font-medium text-brand hover:underline">Manage locations and move sacks or bags &rarr;</a></p>
          <label class="text-sm">Items per sellable pack
            <input class={inputClass} type="number" name="pack_count" min="1" max="999" step="1"
              value={intake?.pack_count ?? ''} placeholder="1, 2, 3, 5…" />
          </label>
          <label class="text-sm">Stock condition
            <select class={inputClass} name="condition_status">
              <option value="complete" selected={!intake ? !intakeDesk : (intake.condition_status ?? 'complete') === 'complete'}>Complete, new</option>
              <option value="review" selected={(!intake && intakeDesk) || intake?.condition_status === 'review'}>Needs checking</option>
              <option value="incomplete" selected={intake?.condition_status === 'incomplete'}>Incomplete / missing pieces</option>
            </select>
          </label>
          <label class="text-sm">Original supplier price tag (reference only)
            <input class={inputClass} name="retail_tag_price" type="number" min="0" step="0.01"
              value={intake?.retail_tag_minor != null ? (intake.retail_tag_minor / 100).toFixed(2) : ''}
              placeholder="e.g. 69.99 (not cost)" />
          </label>
          <label class="text-sm">Tag currency
            <select class={inputClass} name="retail_tag_currency">
              <option value="ZAR" selected={!intake || (intake.retail_tag_currency ?? 'ZAR') === 'ZAR'}>ZAR (R)</option>
              <option value="ZMW" selected={intake?.retail_tag_currency === 'ZMW'}>ZMW (K)</option>
            </select>
          </label>
          <label class="text-sm sm:col-span-2">Private stock notes
            <textarea class={inputClass} name="internal_notes" maxlength="2000" rows="3"
              placeholder="Bundle contents, missing pieces, any uncertain details…">{intake?.internal_notes ?? ''}</textarea>
          </label>
        </div>
        <div data-intake-cost-fields hidden={selectedPricingMode === 'manual'} class="space-y-3">
          <div class="grid gap-3 sm:grid-cols-2">
          <label class="text-sm">Purchase currency
            <select class={inputClass} name="purchase_currency">
              <option value="ZMW" selected={!intake || intake.purchase_currency === 'ZMW'}>ZMW (kwacha)</option>
              <option value="ZAR" selected={intake?.purchase_currency === 'ZAR'}>ZAR (rand)</option>
            </select>
          </label>
          <label class="text-sm">Original purchase cost (each)
            <input class={inputClass} type="number" inputmode="decimal" name="purchase_cost" min="0" step="0.01"
              value={intake?.purchase_cost_minor != null ? (intake.purchase_cost_minor / 100).toFixed(2) : ''} placeholder="Leave blank if unknown" />
          </label>
          <label class="text-sm">Exchange rate (K per R1)
            <input class={inputClass} type="number" inputmode="decimal" name="zar_to_zmw" min="0.000001" step="0.000001"
              value={intake?.zar_to_zmw ?? ''} placeholder="Required for rand costs" />
          </label>
          <label class="text-sm">Allocated sourcing overhead (K per item)
            <input class={inputClass} type="number" inputmode="decimal" name="overhead_zwm" min="0" step="0.01"
              value={((intake?.overhead_zwm_cents ?? 0) / 100).toFixed(2)} />
          </label>
          <label class="text-sm">Target markup (% over landed cost)
            <input class={inputClass} type="number" inputmode="numeric" name="markup_percent" min="0" max="500" step="1"
              value={intake?.markup_percent ?? ''} placeholder="e.g. 35" />
          </label>
          </div>
        <div class="rounded-md bg-paper p-3 text-sm">
          Estimated landed cost: <strong data-intake-landed>{intakeLanded !== null ? `K${(intakeLanded / 100).toFixed(2)}` : 'Enter cost to calculate'}</strong>
          {' · '}
          Suggested price: <strong data-intake-suggested>{intakeSuggested !== null ? `K${(intakeSuggested / 100).toFixed(2)}` : 'Set cost and markup'}</strong>
          <button type="button" data-intake-use-price disabled
            class="mt-3 block rounded-md border border-line bg-white px-3 py-2 text-xs font-semibold disabled:cursor-not-allowed disabled:opacity-50">
            Use suggested selling price
          </button>
        </div>
        <p class="text-xs text-muted">Use the suggested selling price only when the inputs are known.</p>
        </div>
        <p class="text-xs text-muted">The selling price at the top of the form is what shoppers pay. Saving any edit revokes earlier approval and unpublishes the item until you approve again.</p>
      </fieldset>
    )
  }

  {attachmentActive() && <fieldset class="rounded-md border border-line p-4">
    <legend class="px-1 text-sm font-medium">Shipping</legend>
    <label class="flex items-center gap-2 text-sm">
      <input
        name="requires_shipping"
        type="checkbox"
        checked={product ? product.requires_shipping === 1 : true}
        class="h-4 w-4"
      />
      Requires shipping
    </label>
    <p class="mt-1 text-xs text-muted">
      Uncheck for digital goods (ebooks, gift cards). They are excluded from shipment weight
      and never block checkout for a missing weight.
    </p>
    <div class="mt-3">
      <label class="block text-sm font-medium" for="weight">Weight ({weightUnit})</label>
      <input
        id="weight"
        name="weight"
        type="text"
        inputmode="decimal"
        value={product?.weight_grams != null ? formatWeightValue(product.weight_grams, weightUnit) : ''}
        class={inputClass}
      />
      <p class="mt-1 text-xs text-muted">
        Packed item weight, excluding the shared packaging allowance set in Shipping.
        {weightRequired
          ? ' Required: every shipping zone prices by weight, so this product cannot be sold without it.'
          : ' Optional while a flat rate is available.'}
      </p>
    </div>
  </fieldset>}

  <fieldset class="rounded-md border border-line p-4">
    <legend class="px-1 text-sm font-medium">Digital delivery</legend>
    {product?.file_key && (
      <p class="mb-3 text-sm text-muted">
        Attached: <strong>{product.file_name ?? 'download'}</strong>
        {product.file_size_bytes != null && ` (${Math.ceil(product.file_size_bytes / 1024)} KB)`}
      </p>
    )}
    <label class="block text-sm font-medium" for="deliverable">{product?.file_key ? 'Replace file' : 'Attach file'}</label>
    <input
      id="deliverable"
      name="deliverable"
      type="file"
      accept=".pdf,.zip,.epub,.mp3,.m4a,.txt"
      class="mt-1 block w-full text-sm text-muted"
    />
    <p class="mt-1 text-xs text-muted">Private download after payment. PDF, ZIP, EPUB, MP3, M4A, or TXT; 25 MB maximum. For a download-only product, uncheck <strong>Requires shipping</strong> above.</p>
    {product?.file_key && (
      <label class="mt-3 flex items-center gap-2 text-sm">
        <input type="checkbox" name="remove_deliverable" class="h-4 w-4" />
        Remove attachment from future purchases
      </label>
    )}
  </fieldset>

  {
    categoryOptions.length > 0 && (
      <fieldset>
        <legend class="block text-sm font-medium">Categories</legend>
        <div class="mt-1 max-h-48 space-y-1 overflow-auto rounded-md border border-line p-2">
          {categoryOptions.map((c) => (
            <label
              class="flex items-center gap-2 text-sm"
              style={`padding-left:${c.depth * 16}px`}
            >
              {/* cat_ public IDs — resolved back to row ids server-side. */}
              <input
                type="checkbox"
                name="category"
                value={c.public_id}
                checked={selected.has(c.id)}
                class="h-4 w-4"
              />
              {c.name}
            </label>
          ))}
        </div>
      </fieldset>
    )
  }

  <label class="flex items-center gap-2 text-sm">
    <input name="active" type="checkbox"
      checked={!!product && product.active === 1 && intake?.status !== 'draft'}
      disabled={intakeEnabled}
      class="h-4 w-4" />
    Active (visible in storefront)
    {intakeEnabled && <span class="text-xs text-muted">Purkins items are published only through price approval after saving.</span>}
  </label>

  </div>
  <input type="hidden" name="currency" value={defaultCurrency} />

  <div data-editor-save class="flex flex-wrap gap-3 pt-4 border-t border-line">
    {intakeDesk ? (
      <>
        <button type="submit" name="after_create" value="next" class="rounded-md bg-brand px-5 py-2 font-medium text-on-brand hover:bg-brand-hover">
          Save private draft &amp; next
        </button>
        <button type="submit" class="rounded-md border border-line px-4 py-2 text-sm hover:bg-surface">
          Save &amp; view list
        </button>
      </>
    ) : (
      <button type="submit" class="rounded-md bg-brand px-5 py-2 font-medium text-on-brand hover:bg-brand-hover">
        {submitLabel}
      </button>
    )}
    <a href="/admin/products" class="rounded-md border border-line px-5 py-2 hover:bg-surface">Cancel</a>
  </div>
</form>

<script>
  import { parseIntakeFields, landedCostCents, suggestedSellingPriceCents } from '../purkins/intake';

  for (const form of document.querySelectorAll<HTMLFormElement>('form[data-purkins-intake]')) {
    const landedOutput = form.querySelector<HTMLElement>('[data-intake-landed]');
    const suggestedOutput = form.querySelector<HTMLElement>('[data-intake-suggested]');
    const useButton = form.querySelector<HTMLButtonElement>('[data-intake-use-price]');
    const priceField = form.querySelector<HTMLInputElement>('input[name="price"]');
    const costFields = form.querySelector<HTMLElement>('[data-intake-cost-fields]');
    const manualHelp = form.querySelector<HTMLElement>('[data-intake-manual-help]');
    let suggestion: number | null = null;

    function update() {
      const values = new FormData(form);
      const manual = values.get('pricing_mode') === 'manual';
      if (costFields) costFields.hidden = manual;
      if (manualHelp) manualHelp.hidden = !manual;
      const parsed = parseIntakeFields(values);
      const landed = 'data' in parsed ? landedCostCents(parsed.data) : null;
      suggestion = 'data' in parsed ? suggestedSellingPriceCents(parsed.data) : null;
      if (landedOutput) landedOutput.textContent =
        landed === null ? 'Enter cost and rate to calculate' : `K${(landed / 100).toFixed(2)}`;
      if (suggestedOutput) suggestedOutput.textContent =
        suggestion === null ? 'Enter cost and markup to calculate' : `K${(suggestion / 100).toFixed(2)}`;
      if (useButton) useButton.disabled = suggestion === null;
    }

    // Explicit saved-or-new choices work even without JavaScript. When JS is
    // available, selecting one clears the other so no stale override surprises.
    const savedLocation = form.querySelector('select[name="location_id"]') as unknown as HTMLSelectElement | null;
    const newLocation = form.querySelector<HTMLInputElement>('input[name="storage_location_new"]');
    const newLocationDetails = form.querySelector('details[data-intake-new-location]') as unknown as HTMLDetailsElement | null;
    savedLocation?.addEventListener('change', () => {
      if (savedLocation.value && newLocation) {
        newLocation.value = '';
        if (newLocationDetails) newLocationDetails.open = false;
      }
    });
    newLocation?.addEventListener('input', () => {
      if (newLocation.value.trim() && savedLocation) savedLocation.value = '';
    });

    form.addEventListener('input', update);
    form.addEventListener('change', update);
    useButton?.addEventListener('click', () => {
      if (suggestion === null || !priceField) return;
      priceField.value = (suggestion / 100).toFixed(2);
      priceField.focus();
    });
    update();
  }

  // Keep only the shared physical location in this tab. Never put private
  // location, supplier cost or internal notes in URLs or persistent storage.
  const desk = document.querySelector<HTMLFormElement>('form[data-purkins-desk]');
  if (desk) {
    // A rapid double-click must not create two separate drafts.
    let submitting = false;
    desk.addEventListener('submit', (event) => {
      if (submitting) event.preventDefault();
      else submitting = true;
    });
    const locationSelect = desk.querySelector('select[name="location_id"]') as unknown as HTMLSelectElement | null;
    const newLocationInput = desk.querySelector<HTMLInputElement>('input[name="storage_location_new"]');
    const locationKey = 'purkins:stock-intake:location-id:v2';
    try {
      // Server-side saved-item selection takes precedence on Save & Next.
      const serverSelection = locationSelect?.value;
      const prior = sessionStorage.getItem(locationKey);
      if (serverSelection) sessionStorage.setItem(locationKey, serverSelection);
      else if (prior && locationSelect && Array.from(locationSelect.options).some((option) => option.value === prior)) {
        locationSelect.value = prior;
      }
    } catch {
      // Private browsing may disable sessionStorage; manual selection still works.
    }
    const rememberLocation = () => {
      // Only stable location IDs are remembered; new names are selected after
      // the server creates their IDs and returns to the next intake page.
      const value = locationSelect?.value || '';
      try {
        if (value) sessionStorage.setItem(locationKey, value);
        else if (!newLocationInput?.value.trim()) sessionStorage.removeItem(locationKey);
      } catch {
        // Optional convenience only.
      }
    };
    locationSelect?.addEventListener('change', rememberLocation);
    newLocationInput?.addEventListener('input', rememberLocation);

    const nameField = desk.querySelector<HTMLInputElement>('input[name="name"]');
    const barcodeField = desk.querySelector<HTMLInputElement>('input[name="supplier_barcode"]');
    const hints = desk.querySelector<HTMLElement>('[data-intake-duplicates]');
    const list = desk.querySelector<HTMLElement>('[data-intake-duplicate-list]');
    let timer: ReturnType<typeof setTimeout> | undefined;
    let controller: AbortController | undefined;
    async function checkDuplicates() {
      if (!hints || !list) return;
      const terms = [...new Set([barcodeField?.value.trim() ?? '', nameField?.value.trim() ?? ''])]
        .filter((term) => term.length >= 3 && term.length <= 100);
      controller?.abort();
      hints.hidden = true;
      list.replaceChildren();
      if (!terms.length) return;
      const currentController = new AbortController();
      controller = currentController;
      try {
        const matches = await Promise.all(terms.map(async (term) => {
          const response = await fetch('/api/admin/stock-intake/duplicates', {
            method: 'POST',
            credentials: 'same-origin',
            headers: { Accept: 'application/json', 'Content-Type': 'application/json' },
            body: JSON.stringify({ q: term }),
            cache: 'no-store',
            signal: currentController.signal,
          });
          if (!response.ok) throw new Error('Duplicate lookup unavailable');
          const data: { matches?: Array<{ id: string; name: string; sku: string | null }> } =
            await response.json();
          return Array.isArray(data.matches) ? data.matches : [];
        }));
        if (currentController.signal.aborted) return;
        const unique = new Map(matches.flat().filter((m) =>
          typeof m.id === 'string' && m.id.startsWith('prod_') && typeof m.name === 'string',
        ).map((m) => [m.id, m]));
        for (const m of unique.values()) {
          const li = document.createElement('li');
          const a = document.createElement('a');
          a.href = `/admin/products/${encodeURIComponent(m.id)}/edit`;
          a.textContent = m.sku ? `${m.name} · ${m.sku}` : m.name;
          a.className = 'underline hover:text-brand';
          li.appendChild(a);
          list.appendChild(li);
        }
        hints.hidden = unique.size === 0;
      } catch (error) {
        if (error instanceof Error && error.name === 'AbortError') return;
        // Network issues must never block the operator from recording a draft.
        hints.hidden = true;
      }
    }
    for (const field of [nameField, barcodeField]) {
      field?.addEventListener('input', () => {
        if (timer) clearTimeout(timer);
        timer = setTimeout(() => { void checkDuplicates(); }, 450);
      });
    }
  }
</script>
