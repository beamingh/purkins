---
import type { Product } from './db';
import type { CategoryOption } from '../categories/db';
import { getConfig, toMajorUnits, currencyDecimals } from '../../config';
import { formatWeightValue, type WeightUnit } from '../shipping/weight';
import { attachmentActive } from '../digitalDelivery/rollout.ts';
import { landedCostCents, suggestedSellingPriceCents, type IntakeRecord } from '../purkins/intake';

interface Props {
  action: string;
  submitLabel: string;
  product?: Product | null;
  intake?: IntakeRecord | null;
  error?: string | null;
  /** Depth-tagged categories to choose from (empty = no categories yet). */
  categoryOptions?: CategoryOption[];
  /** Ids of categories this product currently belongs to. */
  selectedCategoryIds?: number[];
  /** Show the single-image upload (true on create; edit uses the gallery). */
  showImage?: boolean;
  /** Optional form id, so out-of-tree inputs (e.g. the variants editor) can submit
      with this form via the HTML `form="..."` attribute. */
  formId?: string;
  /** Store-wide weight unit (Admin → Settings). Storage is always grams. */
  weightUnit?: WeightUnit;
  /** True when every enabled zone prices by weight, so a blank weight would make
   *  this product unsellable. Shown as a requirement rather than discovered later. */
  weightRequired?: boolean;
}

const {
  action,
  submitLabel,
  product = null,
  intake = null,
  error = null,
  categoryOptions = [],
  selectedCategoryIds = [],
  showImage = true,
  formId,
  weightUnit = 'g',
  weightRequired = false,
} = Astro.props;
const selected = new Set(selectedCategoryIds);
// New products default to the store currency; edits keep their own.
const defaultCurrency = product?.currency ?? getConfig().currency;
const priceDecimals = currencyDecimals(defaultCurrency);
const price = product
  ? toMajorUnits(product.price_cents, product.currency).toFixed(currencyDecimals(product.currency))
  : (0).toFixed(priceDecimals);
const intakeLanded = intake ? landedCostCents(intake) : null;
const intakeSuggested = intake ? suggestedSellingPriceCents(intake) : null;
const intakeEnabled = product === null || intake !== null;
// Input increment matches the currency's precision: 0.01 (USD), 1 (JPY), 0.001 (BHD).
const priceStep = priceDecimals > 0 ? (10 ** -priceDecimals).toFixed(priceDecimals) : '1';
const inputClass =
  'mt-1 w-full rounded-md border border-line px-3 py-2 focus:border-brand focus:outline-none';
---

<form
  method="POST"
  action={action}
  enctype="multipart/form-data"
  id={formId}
  class="max-w-lg space-y-4"
  data-purkins-intake={intakeEnabled ? '' : undefined}
>
  {
    error && (
      <p class="rounded-md border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700">
        {error}
      </p>
    )
  }

    {
    showImage && (
      <div>
        <label class="block text-sm font-medium" for="image">
          Image
        </label>
        <input id="image" name="image" type="file" accept="image/*" class="mt-1 block w-full text-sm text-muted file:mr-3 file:cursor-pointer file:rounded-md file:border-0 file:bg-brand file:px-4 file:py-2 file:text-xs file:font-medium file:uppercase file:tracking-wider file:text-on-brand hover:file:bg-brand-hover" />
      </div>
    )
  }

  <div>
    <label class="block text-sm font-medium" for="name">Name</label>
    <input id="name" name="name" type="text" required value={product?.name ?? ''} class={inputClass} />
  </div>

  <div>
    <label class="block text-sm font-medium" for="slug">
      Slug <span class="text-faint">(URL — blank to auto-generate from name)</span>
    </label>
    <input
      id="slug"
      name="slug"
      type="text"
      value={product?.slug ?? ''}
      placeholder="auto-from-name"
      class={inputClass}
    />
  </div>

  <div>
    <label class="block text-sm font-medium" for="description">Description</label>
    <textarea id="description" name="description" rows="3" class={inputClass}
      >{product?.description ?? ''}</textarea>
      <p class="mt-1 text-xs text-gray-500">Plain text or Markdown — paragraphs, lists, links, and <code>/images/…</code> media render on the product page.</p>
  </div>

  <div class="grid grid-cols-2 gap-4">
    <div>
      <label class="block text-sm font-medium" for="price">Price ({defaultCurrency.toUpperCase()})</label>
      <input id="price" name="price" type="number" step={priceStep} min="0" required value={price} class={inputClass} />
    </div>
    <div>
      <label class="block text-sm font-medium" for="stock">Stock</label>
      <input id="stock" name="stock" type="number" step="1" min="0" value={product?.stock ?? 0} class={inputClass} />
    </div>
  </div>


  {
    intakeEnabled && (
      <fieldset class="rounded-lg border border-line bg-surface p-4 space-y-3">
        <legend class="px-2 text-sm font-semibold">Purkins stock intake &amp; costing</legend>
        <p class="text-xs text-muted">New products are private drafts. This cost information is accessible to the current admin login only; do not share that login with a partner until separate roles are implemented.</p>
        {intake && <p class="text-sm">Item code: <strong>{intake.sku}</strong> · Price review: <strong>{intake.status === 'approved' ? 'Approved' : 'Draft'}</strong></p>}
        <div class="grid gap-3 sm:grid-cols-2">
          <label class="text-sm">Size
            <input class={inputClass} name="size_label" maxlength="60" value={intake?.size_label ?? ''} placeholder="0–3 months" />
          </label>
          <label class="text-sm">Colour
            <input class={inputClass} name="colour" maxlength="60" value={intake?.colour ?? ''} placeholder="Cream" />
          </label>
          <label class="text-sm">Age range
            <input class={inputClass} name="age_range" maxlength="60" value={intake?.age_range ?? ''} placeholder="Newborn" />
          </label>
          <label class="text-sm">Storage location
            <input class={inputClass} name="storage_location" maxlength="100" value={intake?.storage_location ?? ''} placeholder="Sack A / Shelf 1" />
          </label>
          <label class="text-sm">Purchase currency
            <select class={inputClass} name="purchase_currency">
              <option value="ZMW" selected={!intake || intake.purchase_currency === 'ZMW'}>ZMW (kwacha)</option>
              <option value="ZAR" selected={intake?.purchase_currency === 'ZAR'}>ZAR (rand)</option>
            </select>
          </label>
          <label class="text-sm">Original purchase cost (each)
            <input class={inputClass} type="number" inputmode="decimal" name="purchase_cost" min="0" step="0.01"
              value={intake?.purchase_cost_minor != null ? (intake.purchase_cost_minor / 100).toFixed(2) : ''} placeholder="Leave blank if unknown" />
          </label>
          <label class="text-sm">Exchange rate (K per R1)
            <input class={inputClass} type="number" inputmode="decimal" name="zar_to_zmw" min="0.000001" step="0.000001"
              value={intake?.zar_to_zmw ?? ''} placeholder="Required for rand costs" />
          </label>
          <label class="text-sm">Allocated sourcing overhead (K per item)
            <input class={inputClass} type="number" inputmode="decimal" name="overhead_zwm" min="0" step="0.01"
              value={((intake?.overhead_zwm_cents ?? 0) / 100).toFixed(2)} />
          </label>
          <label class="text-sm">Target markup (% over landed cost)
            <input class={inputClass} type="number" inputmode="numeric" name="markup_percent" min="0" max="500" step="1"
              value={intake?.markup_percent ?? ''} placeholder="e.g. 35" />
          </label>
        </div>
        <div class="rounded-md bg-paper p-3 text-sm">
          Estimated landed cost: <strong data-intake-landed>{intakeLanded !== null ? `K${(intakeLanded / 100).toFixed(2)}` : 'Enter cost to calculate'}</strong>
          {' · '}
          Suggested price: <strong data-intake-suggested>{intakeSuggested !== null ? `K${(intakeSuggested / 100).toFixed(2)}` : 'Set cost and markup'}</strong>
          <button type="button" data-intake-use-price disabled
            class="mt-3 block rounded-md border border-line bg-white px-3 py-2 text-xs font-semibold disabled:cursor-not-allowed disabled:opacity-50">
            Use suggested selling price
          </button>
        </div>
        <p class="text-xs text-muted">The selling price at the top of the form remains the price shoppers pay. Saving any edit revokes an earlier approval and unpublishes the item; review again to publish.</p>
      </fieldset>
    )
  }

  {attachmentActive() && <fieldset class="rounded-md border border-line p-4">
    <legend class="px-1 text-sm font-medium">Shipping</legend>
    <label class="flex items-center gap-2 text-sm">
      <input
        name="requires_shipping"
        type="checkbox"
        checked={product ? product.requires_shipping === 1 : true}
        class="h-4 w-4"
      />
      Requires shipping
    </label>
    <p class="mt-1 text-xs text-muted">
      Uncheck for digital goods (ebooks, gift cards). They are excluded from shipment weight
      and never block checkout for a missing weight.
    </p>
    <div class="mt-3">
      <label class="block text-sm font-medium" for="weight">Weight ({weightUnit})</label>
      <input
        id="weight"
        name="weight"
        type="text"
        inputmode="decimal"
        value={product?.weight_grams != null ? formatWeightValue(product.weight_grams, weightUnit) : ''}
        class={inputClass}
      />
      <p class="mt-1 text-xs text-muted">
        Packed item weight, excluding the shared packaging allowance set in Shipping.
        {weightRequired
          ? ' Required: every shipping zone prices by weight, so this product cannot be sold without it.'
          : ' Optional while a flat rate is available.'}
      </p>
    </div>
  </fieldset>}

  <fieldset class="rounded-md border border-line p-4">
    <legend class="px-1 text-sm font-medium">Digital delivery</legend>
    {product?.file_key && (
      <p class="mb-3 text-sm text-muted">
        Attached: <strong>{product.file_name ?? 'download'}</strong>
        {product.file_size_bytes != null && ` (${Math.ceil(product.file_size_bytes / 1024)} KB)`}
      </p>
    )}
    <label class="block text-sm font-medium" for="deliverable">{product?.file_key ? 'Replace file' : 'Attach file'}</label>
    <input
      id="deliverable"
      name="deliverable"
      type="file"
      accept=".pdf,.zip,.epub,.mp3,.m4a,.txt"
      class="mt-1 block w-full text-sm text-muted"
    />
    <p class="mt-1 text-xs text-muted">Private download after payment. PDF, ZIP, EPUB, MP3, M4A, or TXT; 25 MB maximum. For a download-only product, uncheck <strong>Requires shipping</strong> above.</p>
    {product?.file_key && (
      <label class="mt-3 flex items-center gap-2 text-sm">
        <input type="checkbox" name="remove_deliverable" class="h-4 w-4" />
        Remove attachment from future purchases
      </label>
    )}
  </fieldset>

  {
    categoryOptions.length > 0 && (
      <fieldset>
        <legend class="block text-sm font-medium">Categories</legend>
        <div class="mt-1 max-h-48 space-y-1 overflow-auto rounded-md border border-line p-2">
          {categoryOptions.map((c) => (
            <label
              class="flex items-center gap-2 text-sm"
              style={`padding-left:${c.depth * 16}px`}
            >
              {/* cat_ public IDs — resolved back to row ids server-side. */}
              <input
                type="checkbox"
                name="category"
                value={c.public_id}
                checked={selected.has(c.id)}
                class="h-4 w-4"
              />
              {c.name}
            </label>
          ))}
        </div>
      </fieldset>
    )
  }

  <label class="flex items-center gap-2 text-sm">
    <input name="active" type="checkbox"
      checked={!!product && product.active === 1 && intake?.status !== 'draft'}
      disabled={intakeEnabled}
      class="h-4 w-4" />
    Active (visible in storefront)
    {intakeEnabled && <span class="text-xs text-muted">Purkins items are published only through price approval after saving.</span>}
  </label>

  <input type="hidden" name="currency" value={defaultCurrency} />

  <div class="flex gap-3 pt-2">
    <button type="submit" class="rounded-md bg-brand px-5 py-2 font-medium text-on-brand hover:bg-brand-hover">
      {submitLabel}
    </button>
    <a href="/admin/products" class="rounded-md border border-line px-5 py-2 hover:bg-surface">Cancel</a>
  </div>
</form>

<script>
  import { parseIntakeFields, landedCostCents, suggestedSellingPriceCents } from '../purkins/intake';

  for (const form of document.querySelectorAll<HTMLFormElement>('form[data-purkins-intake]')) {
    const landedOutput = form.querySelector<HTMLElement>('[data-intake-landed]');
    const suggestedOutput = form.querySelector<HTMLElement>('[data-intake-suggested]');
    const useButton = form.querySelector<HTMLButtonElement>('[data-intake-use-price]');
    const priceField = form.querySelector<HTMLInputElement>('input[name="price"]');
    let suggestion: number | null = null;

    function update() {
      const parsed = parseIntakeFields(new FormData(form));
      const landed = 'data' in parsed ? landedCostCents(parsed.data) : null;
      suggestion = 'data' in parsed ? suggestedSellingPriceCents(parsed.data) : null;
      if (landedOutput) landedOutput.textContent =
        landed === null ? 'Enter cost and rate to calculate' : `K${(landed / 100).toFixed(2)}`;
      if (suggestedOutput) suggestedOutput.textContent =
        suggestion === null ? 'Enter cost and markup to calculate' : `K${(suggestion / 100).toFixed(2)}`;
      if (useButton) useButton.disabled = suggestion === null;
    }

    form.addEventListener('input', update);
    form.addEventListener('change', update);
    useButton?.addEventListener('click', () => {
      if (suggestion === null || !priceField) return;
      priceField.value = (suggestion / 100).toFixed(2);
      priceField.focus();
    });
    update();
  }
</script>
