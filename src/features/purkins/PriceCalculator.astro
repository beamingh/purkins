---
/** One device-local calculator shared by authenticated Admin and the offline app.
 * No inventory, customer data or authenticated pages are cached by its SW.
 */
---
<section class="pk-pricing" data-purkins-pricing aria-label="Purkins selling price calculator">
  <div class="pk-pricing__settings">
    <label class="pk-pricing__label" for="pk-zar-rate">ZAR to ZMW rate <small>Kwacha for 1 rand</small></label>
    <input id="pk-zar-rate" data-rate type="number" inputmode="decimal" min="0.000001" step="any" value="1.21" autocomplete="off" />
    <label class="pk-pricing__label" for="pk-markup">Markup (%) <small>Percentage added to cost</small></label>
    <input id="pk-markup" data-markup type="number" inputmode="decimal" min="0" step="any" value="60" autocomplete="off" />
    <div class="pk-pricing__presets" aria-label="Markup presets">
      <button type="button" data-preset="60">60%</button>
      <button type="button" data-preset="70">70%</button>
      <button type="button" data-preset="80">80%</button>
    </div>
    <p class="pk-pricing__hint" data-saved-status aria-live="polite">Rate and markup are saved on this device.</p>
  </div>

  <div class="pk-pricing__main">
    <div class="pk-pricing__mode" role="group" aria-label="Cost price currency">
      <span class="pk-pricing__label">Cost price in</span>
      <div class="pk-pricing__switch">
        <button type="button" data-currency="ZAR" aria-pressed="true">Rand (R)</button>
        <button type="button" data-currency="ZMW" aria-pressed="false">Kwacha (K)</button>
      </div>
    </div>
    <div class="pk-pricing__live">
      <div class="pk-pricing__entry">
        <label class="pk-pricing__primary-label" for="pk-cost-price" data-cost-label>Enter SA price (R)</label>
        <div class="pk-pricing__amount-wrap">
          <span aria-hidden="true" data-symbol>R</span>
          <input id="pk-cost-price" data-amount type="number" inputmode="decimal" min="0" step="any" placeholder="0.00" autocomplete="off" />
        </div>
        <p class="pk-pricing__entry-help">Suggestions from saved prices</p>
        <div class="pk-pricing__suggestions" data-suggestions aria-label="Previous cost price suggestions"></div>
        <p class="pk-pricing__auto" data-auto-status aria-live="polite">Auto-saves a price unchanged for 20 seconds.</p>
      </div>
      <div class="pk-pricing__result" aria-live="polite" aria-atomic="true">
        <span class="pk-pricing__eyebrow">Selling price (ZMW)</span>
        <output data-sale for="pk-cost-price pk-zar-rate pk-markup">K0.00</output>
        <span data-formula class="pk-pricing__formula">Enter a cost price to calculate</span>
      </div>
    </div>
    <div class="pk-pricing__breakdown">
      <div><span>Cost in kwacha</span><output data-cost>K0.00</output></div>
      <div><span>Markup added</span><output data-added>K0.00</output></div>
    </div>
    <div class="pk-pricing__actions">
      <button type="button" data-save disabled>Save to history</button>
      <button type="button" data-copy disabled>Copy selling price</button>
      <button type="button" data-clear>Clear price</button>
    </div>
    <p class="pk-pricing__note">
      Markup is added to cost, not calculated as a gross profit margin. Transport, tax and other landed costs are not added separately.
    </p>
  </div>

  <section class="pk-pricing__history" aria-label="Saved calculations">
    <div class="pk-pricing__history-top">
      <div><h2>Calculation history</h2><p>Stored on this device, available offline. Reuse, remove or export your records.</p></div>
      <span class="pk-pricing__count" data-history-count>0 saved</span>
    </div>
    <div class="pk-pricing__history-tools">
      <label for="pk-history-query" class="pk-pricing__sr">Search saved calculations</label>
      <input id="pk-history-query" data-history-search type="search" placeholder="Search saved prices…" autocomplete="off" />
      <button type="button" data-export>Export CSV</button>
      <button type="button" data-clear-history>Clear history</button>
    </div>
    <div class="pk-pricing__records" data-history-list aria-live="polite"><p>No saved calculations yet.</p></div>
  </section>

  <section class="pk-pricing__install" aria-label="Use calculator offline on your phone">
    <div><h2>Keep this calculator on your phone</h2>
      <p>Open the <a href="/admin/price-calculator-offline">standalone calculator</a> and add it to your home screen. Your history stays available on this device.</p>
      <p class="pk-pricing__install-help">Android: browser menu → Install app / Add to Home screen. iPhone: Safari Share → Add to Home Screen.</p>
    </div>
    <button type="button" data-install hidden>Install calculator</button>
  </section>
</section>
<p class="pk-pricing__connection" data-connection-status role="status">Checking offline availability…</p>

<style is:inline>
  .pk-pricing {display:grid;gap:1rem;color:#111827;font-family:system-ui,-apple-system,"Segoe UI",sans-serif;max-width:100%;min-width:0}
  .pk-pricing__settings,.pk-pricing__main,.pk-pricing__history,.pk-pricing__install {min-width:0;background:#fff;border:1px solid #e7e2d9;border-radius:0.9rem;padding:1rem}
  .pk-pricing__settings {display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.4rem .85rem;align-items:end;background:#f8f7f4}
  .pk-pricing__label {display:block;font-size:.8rem;line-height:1.35;font-weight:700;color:#292929}
  .pk-pricing__label small {display:block;font-size:.72rem;font-weight:400;color:#6b7280;padding-top:.2rem}
  .pk-pricing__settings>.pk-pricing__label:nth-of-type(1){grid-column:1;grid-row:1}
  .pk-pricing__settings>[data-rate]{grid-column:1;grid-row:2}
  .pk-pricing__settings>.pk-pricing__label:nth-of-type(2){grid-column:2;grid-row:1}
  .pk-pricing__settings>[data-markup]{grid-column:2;grid-row:2}
  .pk-pricing__presets{grid-column:1/-1;display:flex;gap:.4rem;flex-wrap:wrap;margin-top:.25rem}
  .pk-pricing__hint{grid-column:1/-1;margin:0;color:#6b7280;font-size:.74rem}
  .pk-pricing input {box-sizing:border-box;width:100%;min-width:0;border:1px solid #c9c4bb;background:#fff;border-radius:.55rem;color:#111827;font:inherit;padding:.6rem .7rem}
  .pk-pricing button{font:inherit;border-radius:.55rem;border:1px solid #d1d5db;cursor:pointer;padding:.65rem .85rem;background:#fff;color:#111827}
  .pk-pricing button:disabled{opacity:.4;cursor:not-allowed}
  .pk-pricing input:focus-visible,.pk-pricing button:focus-visible,.pk-pricing a:focus-visible{outline:3px solid #a5b4fc;outline-offset:2px}
  .pk-pricing__presets button{font-size:.82rem;padding:.4rem .8rem;font-weight:700;background:#fff}
  .pk-pricing__presets button[aria-pressed=true],.pk-pricing__switch button[aria-pressed=true]{background:#111827;color:#fff;border-color:#111827}
  .pk-pricing__main{display:grid;gap:1rem}
  .pk-pricing__mode{display:flex;align-items:center;flex-wrap:wrap;gap:.8rem}
  .pk-pricing__switch{display:flex;gap:.25rem;background:#f4f4f5;padding:.2rem;border-radius:.7rem}
  .pk-pricing__switch button{font-weight:700;padding:.55rem .9rem;background:transparent;border-color:transparent}
  .pk-pricing__live{display:grid;grid-template-columns:minmax(0,1fr);gap:.9rem}
  .pk-pricing__entry{min-width:0}
  .pk-pricing__primary-label{display:block;font-size:1.1rem;font-weight:750;margin-bottom:.7rem}
  .pk-pricing__amount-wrap{position:relative}
  .pk-pricing__amount-wrap>span{position:absolute;left:1rem;top:50%;transform:translateY(-50%);font-size:1.35rem;font-weight:750}
  .pk-pricing__amount-wrap input{border:2px solid #737373;padding:.9rem .8rem .9rem 2.6rem;font-size:clamp(1.6rem,4vw,2.45rem);font-weight:800;font-variant-numeric:tabular-nums}
  .pk-pricing__entry-help{color:#777;font-size:.72rem;margin:.85rem 0 .4rem}
  .pk-pricing__suggestions{display:flex;flex-wrap:wrap;gap:.35rem;min-height:1.75rem}
  .pk-pricing__suggestions button{font-size:.8rem;padding:.28rem .55rem;border-color:#dad5cb;background:#faf8f4}
  .pk-pricing__auto{font-size:.75rem;color:#57534e;margin:.75rem 0 0;min-height:1.3rem}
  .pk-pricing__result{border-radius:.8rem;background:#f5f2eb;padding:1.3rem;min-width:0;min-height:10rem;display:flex;flex-direction:column;justify-content:center;gap:.6rem}
  .pk-pricing__eyebrow{font-size:.75rem;letter-spacing:.06em;text-transform:uppercase;color:#57534e}
  .pk-pricing__result output{font-size:clamp(2.4rem,5vw,3.9rem);font-weight:850;line-height:1.1;overflow-wrap:anywhere;font-variant-numeric:tabular-nums}
  .pk-pricing__formula{font-size:.78rem;color:#57534e;overflow-wrap:anywhere}
  .pk-pricing__breakdown{border-top:1px solid #e7e2d9;padding-top:.85rem;display:grid;gap:.4rem;font-size:.9rem}
  .pk-pricing__breakdown div{display:flex;gap:.7rem;justify-content:space-between}
  .pk-pricing__breakdown span{color:#6b7280}
  .pk-pricing__breakdown output{font-variant-numeric:tabular-nums;font-weight:750}
  .pk-pricing__actions{display:flex;flex-wrap:wrap;gap:.5rem}
  .pk-pricing__actions [data-save]{background:#111827;color:#fff;border-color:#111827;font-weight:750}
  .pk-pricing__note{font-size:.75rem;line-height:1.6;color:#6b7280;margin:0}
  .pk-pricing__history-top{display:flex;gap:1rem;justify-content:space-between;align-items:start}
  .pk-pricing h2{margin:0 0 .35rem;font-size:1.1rem;font-weight:750}
  .pk-pricing__history-top p,.pk-pricing__install p{margin:0;color:#6b7280;font-size:.8rem;line-height:1.55}
  .pk-pricing__count{white-space:nowrap;border-radius:1rem;background:#f3f4f6;padding:.25rem .55rem;font-size:.76rem;font-weight:700}
  .pk-pricing__history-tools{display:flex;flex-wrap:wrap;gap:.45rem;margin:1rem 0}
  .pk-pricing__history-tools input{flex:1 1 160px;width:auto;font-size:.9rem}
  .pk-pricing__history-tools button{font-size:.78rem;padding:.55rem .6rem}
  .pk-pricing__records{display:grid;gap:.5rem}
  .pk-pricing__records>p{color:#6b7280;font-size:.85rem}
  .pk-pricing__record{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:.55rem;border:1px solid #e7e2d9;border-radius:.65rem;padding:.7rem .8rem}
  .pk-pricing__record strong{display:block;font-size:.98rem}
  .pk-pricing__record small{display:block;margin-top:.2rem;color:#6b7280;font-size:.72rem}
  .pk-pricing__record-actions{display:flex;gap:.3rem}
  .pk-pricing__record-actions button{font-size:.76rem;padding:.45rem .65rem}
  .pk-pricing__install{display:flex;align-items:center;justify-content:space-between;gap:1rem;flex-wrap:wrap;background:#faf8f4}
  .pk-pricing__install a{text-decoration:underline;color:#111827}
  .pk-pricing__install .pk-pricing__install-help{margin-top:.4rem}
  .pk-pricing__install [data-install]{background:#111827;color:#fff;font-weight:750}
  .pk-pricing__sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0)}
  .pk-pricing__connection{color:#6b7280;font: .8rem/1.5 system-ui,sans-serif;margin:.8rem 0}
  @media(min-width:680px){.pk-pricing__live{grid-template-columns:minmax(0,1fr) minmax(0,1.15fr)}}
  @media(min-width:760px){.pk-pricing__settings{grid-template-columns:minmax(0,1fr) minmax(0,1fr) minmax(178px,1.1fr)}
    .pk-pricing__presets{grid-column:3;grid-row:2;margin:0}.pk-pricing__hint{grid-column:1/-1;grid-row:3}}
</style>

<script is:inline type="module">
  import { initPriceCalculator } from '/admin/price-calculator-app.mjs';
  initPriceCalculator(document.querySelector('[data-purkins-pricing]'));
</script>
